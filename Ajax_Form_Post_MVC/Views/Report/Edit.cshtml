@model MVC_QuanLyTHP.Models.v_v_web_Report
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("EditPopup", API.web_Report, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessEdit" }))
    {
        @Html.AntiForgeryToken()
        <div class="panel-heading" style="padding-top:15px;padding-right: 15px;">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalEdit")'>&times;</a>
            </div>
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.web_Report)</label></h1>
            <div class="panel-body" style="padding:5px">

            </div>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.ID)
        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "MA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.MA, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MA, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "NAME"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.NAME, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "ID_MENU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.DropDownListFor(model => model.ID_MENU, new SelectList(Model.lstweb_Menu, "ID", "NAME", Model.ID_MENU), !string.IsNullOrEmpty(Model.ID_MENU) ? "" : Utility.GetTitleChon(API.web_Menu), htmlAttributes: new { @class = "form-control chosen-select", id = "lstweb_MenuEdit" })
                        @Html.ValidationMessageFor(model => model.ID_MENU, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "NAME_SP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.NAME_SP, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.NAME_SP, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "REPORT"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.REPORT, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.REPORT, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Report, "NOTE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextAreaFor(model => model.NOTE, new { @class = "form-control", @rows = "3" })
                        @Html.ValidationMessageFor(model => model.NOTE, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group" id="divReport_Edit">
                    <div class="col-sm-5" style="width:100%">
                        <h5 class="subtitle">Danh sách yêu cầu:  @Html.ValidationMessageFor(model => model.lstweb_Report_Parameter, "", new { @class = "text-danger" })</h5>
                        <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                            <div class="panel-body panel-body-nopadding">
                                <div class="form-horizontal form-bordered">
                                    <table class="table table-bordered mb30">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.web_Parameter, "NAME_PARAMETER")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.web_Parameter, "STT")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.web_Parameter, "ISACTIVE")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.web_Parameter, "VALUE")</th>
                                                <th>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyReport_Edit">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalEdit")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                            @Utility.GetTitleFrom(API.web_Report)
                        </a>
                    </h1>
                </div>
                @Html.HiddenFor(model => model.ID)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div id="collapseOne" class="panel-collapse collapse in">
                    <div class="form-horizontal form-bordered">
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "MA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.MA, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MA, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "NAME"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.NAME, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.NAME, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "ID_MENU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.DropDownListFor(model => model.ID_MENU, new SelectList(Model.lstweb_Menu, "ID", "NAME", Model.ID_MENU), !string.IsNullOrEmpty(Model.ID_MENU) ? "" : Utility.GetTitleChon(API.web_Menu), htmlAttributes: new { @class = "form-control chosen-select", id = "lstweb_Menu" })
                                @Html.ValidationMessageFor(model => model.ID_MENU, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "NAME_SP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.NAME_SP, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.NAME_SP, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "REPORT"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.REPORT, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.REPORT, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Report, "NOTE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.TextAreaFor(model => model.NOTE, new { @class = "form-control", @rows = "3" })
                                @Html.ValidationMessageFor(model => model.NOTE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-2">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                            @if (Request.UrlReferrer != null)
                            {
                                <a href="@Request.UrlReferrer.ToString()" class="btn btn-danger">@Utility.QuayLai</a>
                            }
                            else
                            {

                                @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}