@model MVC_QuanLyTHP.Models.v_v_ThongKeThuChi
@using DatabaseTHP;
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using MVC_QuanLyTHP.Models;
@using Newtonsoft.Json;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<hr />
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOneDebt">
                    @Utility.GetTitleFrom(API.ThongKeThuChi)
                </a>
            </h1>
        </div>


        <div id="collapseOneDebt" class="panel-collapse collapse in">
            <div class="panel-body panel-body-nopadding">
                <div class="form-horizontal form-bordered">
                    @using (Html.BeginForm("Index", API.ThongKeThuChi, FormMethod.Post, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnEnd" }))
                    {
                        <div class="form-group">
                            <label class="col-sm-2 control-label">Thời gian:</label>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(model => model.TUNGAY, (Model.TUNGAY).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                                @Html.ValidationMessageFor(model => model.TUNGAY, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(model => model.DENNGAY, (Model.DENNGAY).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                                @Html.ValidationMessageFor(model => model.DENNGAY, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label" for="HINHTHUC">Hình thức:</label>
                            <div class="col-sm-3">
                                <select class="form-control" id="HINHTHUC_THUCHI" name="HINHTHUC_THUCHI">
                                    <option value="2" @(Model.HINHTHUC_THUCHI == "2" ? "selected=\"\"" : "")>Theo tháng</option>
                                    <option value="1" @(Model.HINHTHUC_THUCHI == "1" ? "selected=\"\"" : "")>Theo ngày</option>
                                    <option value="3" @(Model.HINHTHUC_THUCHI == "3" ? "selected=\"\"" : "")>Tất cả</option>
                                </select>
                            </div>
                        </div>
                        <div class="panel-footer">
                            <div class="row">
                                <div class="col-sm-5 col-sm-offset-2">
                                    <button class="btn btn-primary">@Utility.TimKiem</button>
                                    <a id="download-excel" style="background-color: #217346;" class="btn btn-success" onclick="ExportExcel('example-table')"><i class="fa fa-file-text-o" style="margin-right:10px"></i>@Utility.XuatExcel</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div style="overflow-x: auto; Overflow-y: scroll; height: 500px;">
                <div class="panel-body panel-body-nopadding">
                    <div class="form-horizontal form-bordered">
                        <table class="table table-bordered mb30" id="example-table">
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_KhachHang, "NAME")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ThongKeCongNoKhachHang, "THU")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ThongKeCongNoKhachHang, "CHI")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ThongKeCongNoKhachHang, "CONLAI")</th>
                                </tr>
                            </thead>

                            @{
                                double TT_THU = 0, TT_CHI = 0,TT_CONLAI = 0;;
                                if (Model.IPagedList != null && Model.IPagedList.Count() > 0)
                                {
                                    <tbody id="tbodytmpitem">

                                        @foreach (var item in Model.IPagedList)
                                        {
                                            TT_THU += item.SOTIENTHU;
                                            TT_CHI += item.SOTIENCHI;
                                            TT_CONLAI += item.SOTIENTHU - item.SOTIENCHI;
                                            string NGAYLAP = item.HIENTHI;
                                            string THU = item.SOTIENTHU.ToString("N0");
                                            string CHI = item.SOTIENCHI.ToString("N0");
                                            string CONLAI = (item.SOTIENTHU - item.SOTIENCHI).ToString("N0");
                                            if (Model.HINHTHUC_THUCHI == "1")
                                            {
                                                item.TUNGAY = item.NGAYLAP;
                                                item.DENNGAY = item.NGAYLAP;
                                            }
                                            else
                                            {
                                                item.TUNGAY = Model.TUNGAY;
                                                item.DENNGAY = Model.DENNGAY;
                                            }
                                            
                                            if (Model.HINHTHUC_THUCHI == "3")
                                            {
                                                NGAYLAP = Model.TUNGAY.ToString("dd/MM/yyyy") + "-" + Model.DENNGAY.ToString("dd/MM/yyyy");
                                            }

                                            string ShowSearchValue = clsMaHoa.Encrypt(JsonConvert.SerializeObject(item), clsMaHoa.PassMaHoa);
                                            <tr id="@item.NGAYLAP" ondblclick="myFunSuccessDebt('@API.ThongKeThuChi','@ShowSearchValue')">
                                                <td style="white-space: nowrap;text-align:center; " id="NGAYLAP"> @NGAYLAP</td>
                                                <td style="white-space: nowrap; text-align: right;" id="THU"> @THU</td>
                                                <td style="white-space: nowrap; text-align: right;" id="CHI"> @CHI</td>
                                                <td style="white-space: nowrap; text-align: right;" id="CONLAI"> @CONLAI</td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                                <thead>
                                    <tr style="font-weight: bold;">
                                        <td style="white-space: nowrap; text-align: right;" colspan="1">Tổng:</td>
                                        <td style="white-space: nowrap; text-align: right;" id="TT_THU"> @TT_THU.ToString("N0")</td>
                                        <td style="white-space: nowrap; text-align: right;" id="TT_CHI"> @TT_CHI.ToString("N0")</td>
                                        <td style="white-space: nowrap; text-align: right;" id="TT_CONLAI"> @TT_CONLAI.ToString("N0")</td>
                                    </tr>
                                </thead>
                            }
                        </table>
                    </div>
                </div><!-- table-responsive -->
            </div>

            <div class="panel-footer">
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters
        $("input[type='hidden'][name='ISPHATSINHCONGNO']").remove();
        $("input[type='hidden'][name='ISPHATSINHCONGNOTRONGKY']").remove();
        $("input[type='hidden'][name='ISCONCONGNO']").remove();
        $("input[type='hidden'][name='ISTHEOTHOIGIAN']").remove();
    });
</script>