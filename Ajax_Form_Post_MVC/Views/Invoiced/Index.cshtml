                                                <a class="label label-primary" href="#" onclick="copyToClipboard('@item.MACQT.Trim()')"><i class="fa fa-file-text-o" style="margin-right:5px"></i>@item.MACQT.Trim()</a>
                                            }
                                            else
                                            {
                                                <a class="label label-warning" onclick="OnSubmitGetInvoicedList('@item.ID')"><i class="fa fa-cloud-download" style="margin-right:5px"></i></a>
