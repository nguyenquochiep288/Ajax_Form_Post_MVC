        <div class="panel-footer">
            @Html.Raw(ViewBag.TotalSum)
                 @Html.PagedListPager((PagedList.IPagedList<v_ct_HoaDon>
                )Model.IPagedList, page => Url.Action("Index", new { Page = page, ShowSearchValue = ViewBag.showsearchValue, SearchString = ViewBag.searchValue, FromDate = ViewBag.fromdate, ToDate = ViewBag.todate }))
                <div class="form-group">
                    <div class="col-sm-5">
                        <button class="btn btn-primary" onclick="OnSubmitInvoicedList()">@Utility.HoaDon</button>
                        <button class="btn btn-warning" onclick="OnSubmitGetInvoicedList('-1')">@Utility.LayKetQua</button>
                        <button class="btn btn-danger" onclick="OnSubmitDeleteInvoicedList()">@Utility.XoaHoaDon</button>
                    </div>
                </div>
        </div>
    </div>


</div>

@if (Utility.IntWidth == 1)
{
    if (ViewBag.PermissionCreate)
    {
        <button id="myBtnAdd" style="display:none"></button>
        <div id="myModalAdd" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Create", @API.ct_HoaDon, new { type = 1 });}
            </div>
        </div>
    }
    if (ViewBag.PermissionEdit)
    {
        <button id="myBtnEdit" style="display:none"></button>
        <div id="myModalEdit" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Edit", @API.ct_HoaDon, new { type = 1, id = "" });}
            </div>
        </div>
    }
}

<script>
    function OnchangeCheckboxAuto(event) {
        const isChecked = event.target.checked;
        // Gán trạng thái cho cả hai checkbox
        document.getElementById("myCheckbox").checked = isChecked;
        document.getElementById("myCheckboxEdit").checked = isChecked;
    }
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters       
        $("input[type='hidden'][name='item.CHON']").remove();
    });
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text)
            .then(() => {
                //alert("Đã sao chép: " + text);
            })
            .catch(err => {
                console.error("Lỗi sao chép:", err);
            });
    }

    function redirectWithSearch(SearchString) {
        const url = new URL(window.location.href);
        url.searchParams.set('SearchString', SearchString);
        window.location.href = url.toString();
    }
</script>

