                                        @Html.ValidationMessageFor(model => model.TONGTIENGIAMGIA, "", new { @class = "text-danger" })
                                    </td>
                                    <td style="font-weight: bold; text-align:center; white-space: nowrap;">
                                        @Html.EditorFor(model => model.TONGTHANHTIEN, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
