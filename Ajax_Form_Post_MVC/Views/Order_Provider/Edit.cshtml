@model MVC_QuanLyTHP.Models.v_v_ct_PhieuDatHangNCC
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("EditPopup", API.ct_PhieuDatHangNCC, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessEdit" }))
    {

        @Html.AntiForgeryToken()

        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalEdit")'>&times;</a>
            </div>
            <input type="hidden" name="idProduct" id="idProduct" />
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.ct_PhieuNhap)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.LOC_ID)
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.SOPHIEU)
        @Html.HiddenFor(model => model.ID_LOAIPHIEUNHAP)
        @Html.HiddenFor(model => model.ID_NGUOITAO)
        @Html.HiddenFor(model => model.THOIGIANTHEM)
        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "ID_KHO"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.DropDownListFor(model => model.ID_KHO, new SelectList(Model.lstdm_Kho, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_KHO) ? "" : Utility.GetTitleChon(API.dm_Kho), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_KhoEdit" })
                        @Html.ValidationMessageFor(model => model.ID_KHO, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "MAPHIEU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-2">
                        @Html.EditorFor(model => model.MAPHIEU, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.MAPHIEU, "", new { @class = "text-danger" })
                    </div>
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "NGAYLAP"), htmlAttributes: new { @class = "col-sm-1 control-label" })
                    <div class="col-sm-2">
                        @Html.TextBoxFor(model => model.NGAYLAP, (Model.NGAYLAP).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date", @readonly = "readonly" })
                        @Html.ValidationMessageFor(model => model.NGAYLAP, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group" id="divNCCEdit">
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "ID_NHACUNGCAP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        <div class="input-group mb15">
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" onclick="myFunOpenSearch('myModalEdit', '@{@API.dm_NhaCungCap;}', '@API.Chon1', 'lstdm_NhaCungCapEdit', '')"><span class="glyphicon glyphicon-search"></span></button>
                            </span>
                            @Html.DropDownListFor(model => model.ID_NHACUNGCAP, new SelectList(Model.lstdm_NhaCungCap, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHACUNGCAP) ? "" : Utility.GetTitleChon(API.dm_NhaCungCap), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_NhaCungCapEdit" })
                        </div>

                        @Html.ValidationMessageFor(model => model.ID_NHACUNGCAP, "", new { @class = "text-danger" })
                    </div>
                </div>

               
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextAreaFor(model => model.GHICHU, new { @class = "form-control", @rows = "3" })
                        @Html.ValidationMessageFor(model => model.GHICHU, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.ct_PhieuNhap, "CHUNGTUKEMTHEO"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.CHUNGTUKEMTHEO, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.CHUNGTUKEMTHEO, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-5" style="width:100%">
                        <h5 class="subtitle">Danh sách hàng hóa:  @Html.ValidationMessageFor(model => model.lstct_PhieuNhap_ChiTiet, "", new { @class = "text-danger" }) <a href="#" class="pull-right" onclick="myFunOpenSearch('myModalEdit', '@{@API.ct_PhieuNhap;}', '@API.ChonSanPhamNhapXuatChuyen', 'tbodyTempItemInputEdit', '')">+ Thêm sản phẩm</a></h5>
                        <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                            <div class="panel-body panel-body-nopadding">
                                <div class="form-horizontal form-bordered">
                                    <table class="table table-bordered mb30">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "MA")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "NAME")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "ID_DVT") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "SOLUONG") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "DONGIA") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "CHIETKHAU") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "TONGTIENGIAMGIA") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "THANHTIEN") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "THUESUAT") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "TONGTIENVAT") </th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuNhap_ChiTiet, "TONGCONG") </th>
                                                <th>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyTempItemInputEdit">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalEdit")'>@Utility.Dong</a>
                </div>
            </div>
        </div>
    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {

    }
    if (ViewBag.ID != null && !string.IsNullOrEmpty(ViewBag.ID))
    {
        <script>
          var x = document.getElementById("ID");
          x.value = '@ViewBag.ID';
        </script>
    }
}
