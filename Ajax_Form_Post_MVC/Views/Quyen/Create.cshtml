@model MVC_QuanLyTHP.Models.v_v_web_Quyen
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("CreatePopup", API.web_Quyen, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessCreate" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel-heading" style="padding-top:15px;padding-right: 15px;">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalAdd")'>&times;</a>
            </div>

            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.web_Quyen)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.LOC_ID)
        @Html.HiddenFor(model => model.ID)
        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "MAQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.MAQUYEN, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MAQUYEN, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "TENQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.TENQUYEN, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TENQUYEN, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "ID_MENU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.DropDownListFor(model => model.ID_MENU, new SelectList(Model.lstweb_Menu, "ID", "NAME"), Utility.GetTitleChon(API.web_Menu), htmlAttributes: new { @class = "form-control chosen-select", id = "lstweb_Menu" })
                        @Html.ValidationMessageFor(model => model.ID_MENU, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "MOTA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextAreaFor(model => model.MOTA, new { @class = "form-control", @rows = "3" })
                        @Html.ValidationMessageFor(model => model.MOTA, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalAdd")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                            @Utility.GetTitleFrom(API.web_Quyen)
                        </a>
                    </h1>
                </div>

                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.LOC_ID)

                <div id="collapseOne" class="panel-collapse collapse in">
                    <div class="form-horizontal form-bordered">
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "ID"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.ID, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ID, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "MAQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.MAQUYEN, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MAQUYEN, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "TENQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.TENQUYEN, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.TENQUYEN, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "ID_MENU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.DropDownListFor(model => model.ID_MENU, new SelectList(Model.lstweb_Menu, "ID", "NAME"), Utility.GetTitleChon(API.web_Menu), htmlAttributes: new { @class = "form-control chosen-select", id = "lstweb_Menu" })
                                @Html.ValidationMessageFor(model => model.ID_MENU, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.web_Quyen, "MOTA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.TextAreaFor(model => model.MOTA, new { @class = "form-control", @rows = "3" })
                                @Html.ValidationMessageFor(model => model.MOTA, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-2">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                            @if (Request.UrlReferrer != null)
                            {
                                <a href="@Request.UrlReferrer.ToString()">@Utility.QuayLai</a>
                            }
                            else
                            {
                                @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    if (ViewBag.ID != null && !string.IsNullOrEmpty(ViewBag.ID))
    {
        <script>
      var x = document.getElementById("ID");
      x.value = '@ViewBag.ID';
        </script>
    }
}
