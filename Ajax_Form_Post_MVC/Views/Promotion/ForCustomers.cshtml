@model MVC_QuanLyTHP.Controllers.PromotionCustomerPageModel
@using System.Globalization
@{
    Layout = null;
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var monthTitle = Convert.ToString(ViewBag.MonthTitle);
    var noImageUrl = Url.Content("~/Images_Upload/Product/NoImage.png");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#087f70" />
    <title>Khuyến mãi @monthTitle - Trang Hiệp Phát</title>
    <style>
        :root { --green: #078675; --green-dark: #075d53; --ink: #1c2b36; --muted: #667783; --line: #e6ecef; --paper: #fff; }
        * { box-sizing: border-box; }
        body { margin: 0; color: var(--ink); background: #f3f7f8; font: 16px/1.55 "Segoe UI", Arial, sans-serif; }
        .hero { color: #fff; padding: 42px 20px 76px; background: radial-gradient(circle at 82% 10%, rgba(255,255,255,.2), transparent 23%), linear-gradient(125deg, #075d53, #0ba58e); }
        .hero-inner, main, footer { width: min(1080px, calc(100% - 32px)); margin: 0 auto; }
        .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; text-decoration: none; font-weight: 750; letter-spacing: .13em; }
        .brand-mark { display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid rgba(255,255,255,.55); border-radius: 13px; background: rgba(255,255,255,.14); font-size: 18px; }
        .preview-back { display: inline-flex; align-items: center; margin-left: 14px; padding: 8px 12px; border: 1px solid rgba(255,255,255,.55); border-radius: 9px; color: #fff; text-decoration: none; font-size: 14px; font-weight: 650; letter-spacing: normal; }
        .preview-back:hover { color: #fff; background: rgba(255,255,255,.14); }
        .hero h1 { margin: 28px 0 6px; font-size: clamp(30px, 5vw, 48px); line-height: 1.12; }
        .hero p { margin: 0; color: rgba(255,255,255,.84); font-size: 17px; }
        main { position: relative; margin-top: -42px; }
        .summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 18px; padding: 18px 22px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); box-shadow: 0 8px 26px rgba(25,56,64,.07); }
        .summary strong { color: var(--green-dark); font-size: 18px; }
        .summary small { color: var(--muted); }
        .promo-tools { display: grid; grid-template-columns: minmax(220px, 1.5fr) minmax(170px, 1fr) minmax(190px, 1fr); gap: 10px; margin: 0 0 18px; }
        .promo-tools input, .promo-tools select { width: 100%; min-height: 44px; padding: 10px 13px; border: 1px solid #d6e0e4; border-radius: 10px; color: var(--ink); background: #fff; font: inherit; }
        .promo-tools input:focus, .promo-tools select:focus { outline: 3px solid rgba(7,134,117,.14); border-color: var(--green); }
        .promo-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
        .promo { overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); box-shadow: 0 8px 26px rgba(25,56,64,.06); }
        .promo-head { padding: 22px 22px 17px; border-bottom: 1px solid var(--line); }
        .promo-code { display: inline-block; margin-bottom: 9px; color: var(--green); font-size: 12px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
        .promo h2 { margin: 0; font-size: 21px; line-height: 1.35; text-transform: uppercase; }
        .date { display: flex; align-items: center; gap: 8px; margin-top: 13px; color: var(--muted); font-size: 14px; }
        .promo-body { padding: 18px 22px 22px; }
        .badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
        .badge { padding: 6px 10px; border-radius: 999px; color: #075d53; background: #e8f7f3; font-size: 13px; font-weight: 650; }
        .badge.discount { color: #a64024; background: #fff0e9; }
        .section-title { margin: 16px 0 7px; font-size: 14px; font-weight: 750; }
        .details { margin: 0; padding-left: 19px; color: #485a65; }
        .details li { margin: 4px 0; }
        .product-list { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }
        .product-item { display: flex; align-items: center; gap: 10px; min-width: 0; color: #485a65; }
        .product-image-button { flex: 0 0 48px; width: 48px; height: 48px; padding: 0; border: 0; border-radius: 9px; background: transparent; cursor: zoom-in; }
        .product-thumb { flex: 0 0 48px; width: 48px; height: 48px; border: 1px solid var(--line); border-radius: 9px; object-fit: cover; background: #f5f8f9; }
        .product-image-button:focus-visible { outline: 3px solid rgba(7,134,117,.3); outline-offset: 3px; }
        .product-copy { min-width: 0; }
        .product-more { display: grid; width: 100%; max-height: none; overflow: hidden; }
        .product-more.is-collapsed:not(.is-expanded) li:nth-child(n+5) { display: none; }
        .product-more.is-expanded { max-height: none; }
        .more-button { margin-top: 9px; padding: 7px 11px; border: 1px solid #b8dfd8; border-radius: 8px; color: var(--green-dark); background: #f0faf7; font: inherit; font-size: 13px; font-weight: 650; cursor: pointer; }
        .more-button:hover { background: #e2f5f0; }
        .filter-empty { display: none; margin-top: 14px; }
        .back-to-top { position: fixed; right: 22px; bottom: 22px; z-index: 1000; display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 50%; color: #fff; background: var(--green); box-shadow: 0 5px 16px rgba(7,93,83,.28); font-size: 23px; line-height: 1; cursor: pointer; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity .2s ease, transform .2s ease, visibility .2s ease, background .2s ease; }
        .back-to-top.is-visible { opacity: 1; visibility: visible; transform: translateY(0); }
        .back-to-top:hover { background: var(--green-dark); }
        .back-to-top:focus-visible { outline: 3px solid rgba(7,134,117,.3); outline-offset: 3px; }
        .image-viewer[hidden] { display: none; }
        .image-viewer { position: fixed; inset: 0; z-index: 2000; display: grid; place-items: center; padding: 24px; background: rgba(10,20,25,.82); }
        .image-viewer-content { position: relative; display: grid; place-items: center; max-width: min(100%, 1100px); max-height: 100%; }
        .image-viewer img { display: block; max-width: min(90vw, 1100px); max-height: 88vh; border-radius: 12px; object-fit: contain; background: #fff; box-shadow: 0 18px 60px rgba(0,0,0,.35); }
        .image-viewer-close { position: absolute; top: -16px; right: -16px; z-index: 1; display: grid; place-items: center; width: 42px; height: 42px; border: 2px solid #fff; border-radius: 50%; color: #fff; background: #17252e; font-size: 25px; line-height: 1; cursor: pointer; }
        .empty, .error { padding: 42px 20px; border: 1px solid var(--line); border-radius: 16px; background: var(--paper); text-align: center; }
        .empty-icon { display: grid; place-items: center; width: 58px; height: 58px; margin: 0 auto 12px; border-radius: 50%; color: var(--green); background: #e8f7f3; font-size: 27px; }
        .empty h2 { margin: 0 0 5px; font-size: 21px; }
        .empty p, .error { color: var(--muted); }
        footer { padding: 25px 0 35px; color: var(--muted); font-size: 13px; text-align: center; }
        @@media (max-width: 700px) {
            .hero { padding: 28px 0 66px; }
            .hero-inner, main, footer { width: min(100% - 24px, 520px); }
            .hero h1 { margin-top: 23px; }
            .hero p { font-size: 15px; }
            .summary { align-items: flex-start; flex-direction: column; gap: 2px; padding: 15px 17px; }
            .promo-tools { grid-template-columns: 1fr; gap: 8px; }
            .promo-list { grid-template-columns: 1fr; gap: 13px; }
            .promo-head { padding: 18px 17px 14px; }
            .promo-body { padding: 15px 17px 18px; }
            .promo h2 { font-size: 19px; }
            .back-to-top { right: 14px; bottom: 16px; width: 44px; height: 44px; }
        }
    </style>
</head>
<body>
    <header class="hero">
        <div class="hero-inner">
            <a class="brand" href="@(Model.PreviewMode ? "#" : "/")" aria-label="Trang Hiệp Phát">
                <span class="brand-mark">THP</span><span>TRANG HIỆP PHÁT</span>
            </a>
            @if (Model.PreviewMode)
            {
                <span class="preview-back">BẢN MÔ PHỎNG</span>
                <h1>Xem trước chương trình khuyến mãi</h1>
                <p>Bản mô phỏng thẻ ưu đãi khách hàng sẽ thấy trên trang khuyến mãi.</p>
            }
            else
            {
                <h1>Ưu đãi dành cho bạn</h1>
                <p>Chương trình khuyến mãi @monthTitle. Chọn ưu đãi phù hợp và hỏi nhân viên để được hỗ trợ.</p>
            }
        </div>
    </header>
    <main>
        @if (!string.IsNullOrWhiteSpace(Model.LoadError))
        {
            <div class="error" role="alert">@Model.LoadError</div>
        }
        else if (Model.Promotions == null || !Model.Promotions.Any())
        {
            <section class="empty">
                <div class="empty-icon" aria-hidden="true">✦</div>
                <h2>Chưa có chương trình khuyến mãi</h2>
                <p>Hiện chưa có ưu đãi áp dụng trong @monthTitle. Hãy quay lại sau để xem chương trình mới.</p>
            </section>
        }
        else
        {
            <div class="summary">
                <strong><span id="visibleCount">@Model.Promotions.Count</span> @(Model.PreviewMode ? "bản xem trước" : "chương trình đang áp dụng")</strong>
                <small>@(Model.PreviewMode ? "Mã " + Model.Promotions[0].MA + " · Mô phỏng thẻ trên trang khuyến mãi khách hàng" : monthTitle + " · Thông tin được cập nhật từ Trang Hiệp Phát")</small>
            </div>
            <div class="promo-tools" role="search" aria-label="Tìm và lọc khuyến mãi" style="@(Model.PreviewMode ? "display:none;" : "")">
                <input id="promoSearch" type="search" placeholder="Tìm theo tên, mã hoặc sản phẩm..." aria-label="Tìm khuyến mãi" />
                <select id="promoFilter" aria-label="Lọc chương trình">
                    <option value="all">Tất cả chương trình</option>
                    <option value="discount">Có giảm giá</option>
                    <option value="gift">Có quà tặng</option>
                    <option value="cumulative">Tính lũy kế</option>
                    <option value="detailed">Có điều kiện sản phẩm</option>
                </select>
                <select id="promoSort" aria-label="Sắp xếp chương trình">
                    <option value="default">Sắp xếp: Mặc định</option>
                    <option value="discount">Giảm giá cao nhất</option>
                    <option value="expiry">Sắp hết hạn</option>
                    <option value="name">Tên A–Z</option>
                </select>
            </div>
            <section class="promo-list" aria-label="Danh sách chương trình khuyến mãi">
                @foreach (var promo in Model.Promotions)
                {
                    <article class="promo"
                             data-name="@promo.NAME"
                             data-code="@promo.MA"
                             data-discount-percent="@promo.CHIETKHAU"
                             data-discount-amount="@promo.TIENGIAM"
                             data-has-discount="@(promo.CHIETKHAU > 0 || promo.TIENGIAM > 0 ? "true" : "false")"
                             data-has-gift="@(promo.Gifts != null && promo.Gifts.Any() ? "true" : "false")"
                             data-cumulative="@(promo.ISTINHLUYTUYEN ? "true" : "false")"
                             data-detailed="@(promo.IS_YEUCAUCHITIET ? "true" : "false")"
                             data-expiry="@promo.DENNGAY.ToString("yyyy-MM-dd")">
                        <div class="promo-head">
                            <span class="promo-code">@(string.IsNullOrWhiteSpace(promo.MA) ? "Ưu đãi" : "Mã " + promo.MA)</span>
                            <h2>@promo.NAME</h2>
                            <div class="date"><span aria-hidden="true">◷</span> @promo.TUNGAY.ToString("dd/MM/yyyy") – @promo.DENNGAY.ToString("dd/MM/yyyy")</div>
                        </div>
                        <div class="promo-body">
                            <div class="badges">
                                @if (promo.CHIETKHAU > 0)
                                {
                                    <span class="badge discount">Giảm @promo.CHIETKHAU.ToString("0.##", vi)%</span>
                                }
                                @if (promo.TIENGIAM > 0)
                                {
                                    <span class="badge discount">Giảm @promo.TIENGIAM.ToString("N0", vi) đ</span>
                                }
                                @if (promo.TONGTIEN_DATKM > 0)
                                {
                                    <span class="badge">Đơn từ @promo.TONGTIEN_DATKM.ToString("N0", vi) đ</span>
                                }
                                @if (promo.SOLUONG_DATKM > 0)
                                {
                                    <span class="badge">Từ @promo.SOLUONG_DATKM.ToString("0.##", vi) @(promo.NAME_DVT ?? "sản phẩm")</span>
                                }
                                @if (promo.ISTONGHOADON)
                                {
                                    <span class="badge">Áp dụng trên tổng hóa đơn</span>
                                }
                                @if (promo.IS_YEUCAUCHITIET)
                                {
                                    <span class="badge">Có điều kiện sản phẩm</span>
                                }
                                @if (promo.ISTINHLUYTUYEN)
                                {
                                    <span class="badge">Tính lũy kế</span>
                                }
                            </div>
                            @if (promo.Requirements != null && promo.Requirements.Any())
                            {
                                <div class="section-title">Điều kiện áp dụng</div>
                                var requirementsNeedMore = promo.Requirements.Count > 4;
                                <ul class="product-list product-more @(requirementsNeedMore ? "is-collapsed" : "")">
                                    @foreach (var requirement in promo.Requirements)
                                    {
                                        <li class="product-item">
                                            <button type="button" class="product-image-button" aria-label="Phóng to ảnh @requirement.NAME" title="Bấm để xem ảnh lớn">
                                                <img class="product-thumb" src="@Url.Content("~/Images_Upload/Product/" + (string.IsNullOrWhiteSpace(requirement.PICTURE) ? "NoImage.png" : requirement.PICTURE))" onerror="this.onerror=null;this.src='@noImageUrl';" alt="Ảnh @requirement.NAME" loading="lazy" />
                                            </button>
                                            <span class="product-copy">
                                                @requirement.NAME
                                                @if (requirement.SOLUONG > 0) { <span> · @requirement.SOLUONG.ToString("0.##", vi) @(requirement.NAME_DVT ?? "")</span> }
                                                @if (requirement.SOTIEN > 0) { <span> · từ @requirement.SOTIEN.ToString("N0", vi) đ</span> }
                                                @if (requirement.CHIETKHAU > 0) { <span> · giảm @requirement.CHIETKHAU.ToString("0.##", vi)%</span> }
                                                @if (requirement.TIENGIAM > 0) { <span> · giảm @requirement.TIENGIAM.ToString("N0", vi) đ</span> }
                                            </span>
                                        </li>
                                    }
                                </ul>
                                if (requirementsNeedMore)
                                {
                                    <button type="button" class="more-button" aria-expanded="false">Xem thêm (@(promo.Requirements.Count - 4))</button>
                                }
                            }
                            @if (promo.Gifts != null && promo.Gifts.Any())
                            {
                                <div class="section-title">Quà tặng</div>
                                var giftsNeedMore = promo.Gifts.Count > 4;
                                <ul class="product-list product-more @(giftsNeedMore ? "is-collapsed" : "")">
                                    @foreach (var gift in promo.Gifts)
                                    {
                                        <li class="product-item">
                                            <button type="button" class="product-image-button" aria-label="Phóng to ảnh @gift.NAME" title="Bấm để xem ảnh lớn">
                                                <img class="product-thumb" src="@Url.Content("~/Images_Upload/Product/" + (string.IsNullOrWhiteSpace(gift.PICTURE) ? "NoImage.png" : gift.PICTURE))" onerror="this.onerror=null;this.src='@noImageUrl';" alt="Ảnh @gift.NAME" loading="lazy" />
                                            </button>
                                            <span class="product-copy">@gift.NAME@if (gift.SOLUONG > 0) { <span> · @gift.SOLUONG.ToString("0.##", vi) @(gift.NAME_DVT ?? "")</span> }</span>
                                        </li>
                                    }
                                </ul>
                                if (giftsNeedMore)
                                {
                                    <button type="button" class="more-button" aria-expanded="false">Xem thêm (@(promo.Gifts.Count - 4))</button>
                                }
                            }
                        </div>
                    </article>
                }
            </section>
            <section id="filterEmpty" class="empty filter-empty" aria-live="polite">
                <div class="empty-icon" aria-hidden="true">⌕</div>
                <h2>Không tìm thấy ưu đãi phù hợp</h2>
                <p>Thử thay đổi nội dung tìm kiếm hoặc điều kiện lọc.</p>
            </section>
        }
    </main>
    <footer>© @DateTime.Today.Year Trang Hiệp Phát · Vui lòng liên hệ nhân viên để xác nhận ưu đãi trước khi thanh toán.</footer>
    <button id="backToTop" class="back-to-top" type="button" aria-label="Về đầu trang" title="Về đầu trang">↑</button>
    <div id="imageViewer" class="image-viewer" role="dialog" aria-modal="true" aria-label="Xem ảnh sản phẩm" aria-hidden="true" hidden>
        <div class="image-viewer-content">
            <button id="imageViewerClose" class="image-viewer-close" type="button" aria-label="Đóng ảnh">×</button>
            <img id="imageViewerImage" src="" alt="" />
        </div>
    </div>
    <script>
        (function () {
            var backToTop = document.getElementById('backToTop');
            function updateBackToTop() {
                backToTop.classList.toggle('is-visible', window.scrollY > 300);
            }
            window.addEventListener('scroll', updateBackToTop, { passive: true });
            backToTop.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
            updateBackToTop();

            var imageViewer = document.getElementById('imageViewer');
            var imageViewerImage = document.getElementById('imageViewerImage');
            var imageViewerClose = document.getElementById('imageViewerClose');
            var lastImageButton = null;
            function closeImageViewer() {
                imageViewer.hidden = true;
                imageViewer.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
                if (lastImageButton) lastImageButton.focus();
            }
            document.addEventListener('click', function (event) {
                var imageButton = event.target.closest('.product-image-button');
                if (imageButton) {
                    var productImage = imageButton.querySelector('img');
                    if (!productImage) return;
                    lastImageButton = imageButton;
                    imageViewerImage.src = productImage.currentSrc || productImage.src;
                    imageViewerImage.alt = productImage.alt;
                    imageViewer.hidden = false;
                    imageViewer.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                    imageViewerClose.focus();
                    return;
                }
                if (event.target === imageViewer || event.target === imageViewerClose) closeImageViewer();
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && !imageViewer.hidden) closeImageViewer();
            });

            var list = document.querySelector('.promo-list');
            if (!list) return;

            var cards = Array.prototype.slice.call(list.querySelectorAll('.promo'));
            var search = document.getElementById('promoSearch');
            var filter = document.getElementById('promoFilter');
            var sort = document.getElementById('promoSort');
            var count = document.getElementById('visibleCount');
            var empty = document.getElementById('filterEmpty');

            if (!search || !filter || !sort || !count || !empty) return;

            function updatePromotions() {
                var query = search.value.trim().toLocaleLowerCase('vi');
                var filterValue = filter.value;
                var sortValue = sort.value;
                var visible = cards.filter(function (card) {
                    var matchesText = !query || card.textContent.toLocaleLowerCase('vi').indexOf(query) !== -1;
                    var matchesFilter = filterValue === 'all' ||
                        (filterValue === 'discount' && card.dataset.hasDiscount === 'true') ||
                        (filterValue === 'gift' && card.dataset.hasGift === 'true') ||
                        (filterValue === 'cumulative' && card.dataset.cumulative === 'true') ||
                        (filterValue === 'detailed' && card.dataset.detailed === 'true');
                    return matchesText && matchesFilter;
                });

                visible.sort(function (a, b) {
                    if (sortValue === 'discount') {
                        var percentDifference = Number(b.dataset.discountPercent) - Number(a.dataset.discountPercent);
                        return percentDifference || Number(b.dataset.discountAmount) - Number(a.dataset.discountAmount);
                    }
                    if (sortValue === 'expiry') return a.dataset.expiry.localeCompare(b.dataset.expiry);
                    if (sortValue === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '', 'vi');
                    return cards.indexOf(a) - cards.indexOf(b);
                });

                cards.forEach(function (card) { card.hidden = visible.indexOf(card) === -1; });
                visible.forEach(function (card) { list.appendChild(card); });
                count.textContent = visible.length;
                empty.style.display = visible.length ? 'none' : 'block';
            }

            search.addEventListener('input', updatePromotions);
            filter.addEventListener('change', updatePromotions);
            sort.addEventListener('change', updatePromotions);

            list.addEventListener('click', function (event) {
                var button = event.target.closest('.more-button');
                if (!button) return;
                var details = button.previousElementSibling;
                var expanded = details.classList.toggle('is-expanded');
                button.setAttribute('aria-expanded', expanded ? 'true' : 'false');
                button.textContent = expanded ? 'Thu gọn' : 'Xem thêm (' + Math.max(0, details.querySelectorAll('li').length - 4) + ')';
            });
        })();
    </script>
</body>
</html>
