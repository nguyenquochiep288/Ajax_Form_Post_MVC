@model MVC_QuanLyTHP.Models.PriceCalculationRunModel
<style>
    .pr-picker{border:1px solid #ccd5df;border-radius:6px;background:#fff;padding:9px}.pr-picker summary{cursor:pointer;color:#087d72}.pr-picker-list{max-height:220px;overflow:auto;margin-top:8px}.pr-picker-list label{display:flex;align-items:center;gap:8px;padding:7px;margin:0;font-weight:400}.pr-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}.pr-chip{border:0;border-radius:14px;background:#e6f6f3;color:#087d72;padding:4px 9px}.pr-field{min-width:0}.pr-field input[type=date]{min-width:0;width:100%;max-width:100%;box-sizing:border-box}
    .price-run{padding:18px}.price-run h2{text-align:center;margin:0 0 18px}.pr-card{background:#fff;border:1px solid #ddd;border-radius:9px;margin-bottom:16px;box-shadow:0 2px 8px rgba(0,0,0,.05)}.pr-card-title{font-size:20px;font-weight:600;padding:14px 18px;border-bottom:1px solid #e5e5e5;color:#536b83}.pr-card-body{padding:18px}.pr-grid{display:grid;grid-template-columns:repeat(4,minmax(170px,1fr));gap:14px;align-items:end}.pr-field label{display:block;font-weight:500;margin-bottom:6px}.pr-field .form-control{height:42px}.pr-help{font-size:12px;color:#718096;margin-top:6px}.pr-formula{padding:12px 14px;border:1px solid #cce6e1;border-radius:7px;background:#f0faf8;margin-bottom:8px}.pr-formula strong{color:#087d72}.pr-expression{font-family:Consolas,monospace;overflow-wrap:anywhere;margin:7px 0}.pr-table-wrap{overflow:auto;max-height:60vh}.pr-table{min-width:1750px;margin-bottom:0}.pr-table th{white-space:nowrap;background:#f7f9fb}.pr-table td{vertical-align:middle}.pr-status{font-weight:600}.pr-status-ready{color:#087d72}.pr-status-error{color:#b42318}.pr-status-applied{color:#126b3a}.pr-toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin:12px 0}.pr-empty{text-align:center;color:#718096;padding:32px}.pr-callout{background:#f4f8fb;border-left:4px solid #11a995;padding:10px 14px;margin-bottom:14px}.pr-date{white-space:nowrap}.pr-diff-up{color:#b42318}.pr-diff-down{color:#087d72}.pr-converted{white-space:nowrap;color:#087d72;font-weight:600}
    .pr-scope-grid{align-items:start}.pr-group-picker{padding:0;min-height:42px;box-sizing:border-box}.pr-group-picker>summary{min-height:40px;box-sizing:border-box;padding:9px 12px;line-height:22px;overflow-wrap:anywhere}.pr-group-picker>input.form-control{width:calc(100% - 18px);margin:0 9px}.pr-group-picker .pr-picker-list{padding:0 9px 9px}.pr-group-picker .pr-picker-list label{display:flex;align-items:center;margin:0;font-weight:400}.pr-chips:empty{display:none}
    .pr-price-edit{width:125px;min-width:110px;height:34px;padding:5px 8px;text-align:right}.pr-price-edit.pr-input-error{border-color:#d92d20;background:#fff5f4}.pr-receipt-code{display:block;margin-top:3px;color:#52667a;white-space:nowrap}.price-delta{white-space:nowrap}
    @@media(max-width:900px){.price-run{padding:10px}.pr-grid{grid-template-columns:1fr 1fr}.pr-card-body{padding:12px}}
    @@media(max-width:600px){.pr-grid{grid-template-columns:1fr}.pr-toolbar>*{width:100%}.pr-toolbar .btn{width:auto}}
</style>
<div class="price-run" style="@(Model.Embedded ? "padding:0" : "")">
    @if (!Model.Embedded) { <h2>TÍNH GIÁ THEO CÔNG THỨC</h2> }
    <div id="priceRunMessage" class="alert" style="display:none"></div>
    <div class="pr-card">
        <div class="pr-card-title">@(Model.Embedded ? "5. Chọn phạm vi hoặc nạp Excel để tính giá" : "1. Chọn phạm vi tính và nạp Excel")</div>
        <div class="pr-card-body">
            <div class="pr-grid pr-scope-grid">
                @if (!Model.Embedded) {
                <div class="pr-field"><label for="priceType">Loại giá cần cập nhật</label><select id="priceType" class="form-control"><option value="GIA01">Giá bán 1</option><option value="GIA02">Giá bán 2</option><option value="GIA03">Giá bán 3</option><option value="GIAMUA">Giá mua</option></select></div>
                <div class="pr-field"><label>Nhóm hàng hóa</label><details class="pr-picker pr-group-picker"><summary id="priceGroupSummary">Tất cả nhóm hàng hóa</summary><input type="search" id="priceGroupSearch" class="form-control" placeholder="Tìm nhóm…" aria-label="Tìm nhóm hàng hóa" /><div id="priceGroups" class="pr-picker-list">
                    @foreach (var group in Model.Groups) { <label><input type="checkbox" value="@group.ID" data-label="@group.NAME" /> <span>@group.NAME</span></label> }
                </div></details><div id="priceGroupChips" class="pr-chips"></div><div class="pr-help">Không chọn nhóm = tất cả nhóm.</div></div>
                }
                <div class="pr-field"><label for="priceDate">Ngày áp dụng</label><input id="priceDate" class="form-control" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" /></div>
                <div class="pr-field"><label for="priceSource">Nguồn hàng hóa</label><select id="priceSource" class="form-control"><option value="catalog">Chọn từ danh mục hàng hóa</option><option value="excel">Nạp từ file Excel</option></select></div>
            </div>
            <div id="catalogScope" style="margin-top:14px">
                <label>Hàng hóa</label>
                <details id="catalogPicker" class="pr-picker"><summary id="catalogSummary">Tất cả hàng hóa trong nhóm đã chọn</summary>
                    <div class="pr-toolbar"><input id="catalogSearch" type="search" class="form-control" style="max-width:380px" placeholder="Tìm mã hoặc tên hàng…" aria-label="Tìm hàng hóa trong danh mục" /><button id="loadCatalog" type="button" class="btn btn-default">Nạp danh sách</button><button id="allCatalog" type="button" class="btn btn-default">Chọn tất cả kết quả</button><button id="clearAllCatalog" type="button" class="btn btn-default">Bỏ chọn tất cả kết quả</button></div>
                    <div id="catalogOptions" class="pr-picker-list">Bấm Nạp danh sách để chọn từng hàng; để mặc định sẽ tính tất cả hàng trong nhóm.</div>
                </details><div id="catalogChips" class="pr-chips"></div>
                <div class="pr-help">Để tính toàn bộ hàng: chọn nhóm ở trên rồi bấm <strong>Tính xem trước</strong>. Không chọn nhóm sẽ lấy tất cả nhóm.<br />Để chọn riêng từng hàng: mở mục này, bấm <strong>Nạp danh sách</strong> rồi chọn hoặc bỏ chọn kết quả đã nạp.</div>
            </div>
            <div class="pr-field" style="margin-top:14px"><label for="excelFile">Hoặc chọn file Excel</label><input id="excelFile" class="form-control" type="file" accept=".xlsx,.xls,.csv" /></div>
            <div class="pr-toolbar">
                <button id="downloadTemplate" class="btn btn-default" type="button"><i class="fa fa-download"></i> Tải file mẫu</button>
                <button id="previewPrices" class="btn btn-primary" type="button"><i class="fa fa-calculator"></i> Tính xem trước</button>
                <span id="fileSummary" class="text-muted"></span>
            </div>
            <div class="pr-callout">File gồm <b>MAHANG</b>, <b>TEN HANG</b>, <b>GIAHIENTAI</b>. Khi nạp Excel, <b>GIAHIENTAI là giá nhập gốc theo đơn vị gốc</b> (lớn hơn 0), dùng làm <b>GIAMUA</b> trong công thức. Giá hiện tại để so sánh lấy từ danh mục. Khi chọn từ danh mục, giá nhập lấy từ đơn giá trước chiết khấu lớn hơn 0 trên phiếu nhập gần nhất.</div>
            @if (Model.Embedded) { <p class="pr-help">Dùng loại giá, nhóm hàng, công thức và giá trị mặc định ở trên. Có thể xem trước khi chưa lưu; để cập nhật giá hàng hóa, hãy lưu công thức rồi tính xem trước lại. Ngày áp dụng là ngày đối chiếu giá nhập và hiệu lực; bấm Áp dụng sẽ cập nhật giá ngay.</p> }
        </div>
    </div>

    <div id="formulaSection" class="pr-card">
        <div class="pr-card-title">@(Model.Embedded ? "Công thức sẽ dùng" : "2. Công thức sẽ dùng")</div>
        <div id="formulaList" class="pr-card-body">Chọn phạm vi hoặc nạp Excel rồi bấm Tính xem trước để xem công thức phù hợp.</div>
    </div>

    <div id="resultSection" class="pr-card">
        <div class="pr-card-title">@(Model.Embedded ? "Kết quả xem trước" : "3. Kết quả xem trước")</div>
        <div class="pr-card-body">
            <div class="pr-grid" style="grid-template-columns:minmax(220px,1fr) minmax(180px,280px);margin-bottom:12px">
                <div class="pr-field"><label for="productSearch">Lọc kết quả hàng hóa</label><input id="productSearch" class="form-control" placeholder="Tìm mã hoặc tên hàng..." /></div>
                <div class="pr-field"><label for="productFilter">Chọn nhanh hàng hóa</label><select id="productFilter" class="form-control"><option value="">Tất cả hàng hóa</option></select></div>
            </div>
            <div class="pr-toolbar">
                <button id="selectVisible" type="button" class="btn btn-default btn-sm">Chọn dòng đang hiển thị</button>
                <button id="clearVisible" type="button" class="btn btn-default btn-sm">Bỏ chọn dòng đang hiển thị</button>
                <span id="resultSummary" class="text-muted"></span>
            </div>
            <div class="pr-table-wrap"><table class="table table-bordered table-striped pr-table">
                <thead>
                    <tr><th rowspan="2"><input id="selectAllRows" type="checkbox" aria-label="Chọn tất cả" /></th><th rowspan="2">Mã hàng</th><th rowspan="2">Tên hàng</th><th colspan="3" class="text-center">Giá hiện tại</th><th colspan="2" class="text-center">Giá nhập dùng tính (đơn vị gốc / QĐ)</th><th rowspan="2">Nguồn giá nhập<br />(Ngày / Mã phiếu)</th><th rowspan="2">Giá mới tính<br /><small>Có thể sửa</small></th><th rowspan="2">Giá QĐ mới</th><th rowspan="2">Chênh lệch</th><th rowspan="2">Công thức áp dụng</th><th rowspan="2">Trạng thái</th></tr>
                    <tr><th>Giá hiện tại</th><th>Tỷ lệ QĐ</th><th>Giá QĐ hiện tại</th><th>Đơn vị gốc</th><th>Đơn vị QĐ</th></tr>
                </thead>
                <tbody id="priceRows"><tr><td colspan="14" class="pr-empty">Chưa có kết quả xem trước.</td></tr></tbody>
            </table></div>
            <div class="pr-toolbar">
                @if (Model.CanApply) { <button id="applyPrices" type="button" class="btn btn-success" disabled><i class="fa fa-check"></i> Áp dụng giá đã chọn</button> }
                else { <span class="text-warning">Tài khoản chưa được cấp quyền cập nhật giá.</span> }
                @if (Model.CanApply) { <button id="restoreLatestPrices" type="button" class="btn btn-warning" style="display:none" disabled><i class="fa fa-undo"></i> Khôi phục giá cũ lần gần nhất</button> }
                <button id="exportResult" type="button" class="btn btn-default" disabled><i class="fa fa-file-excel-o"></i> Xuất kết quả</button>
                <span id="restoreSummary" class="text-muted"></span>
                @if (!Model.Embedded) { @Html.AntiForgeryToken() }
            </div>
        </div>
    </div>
</div>
<script>
(function () {
    var importedItems = [], previewRows = [], previewSnapshot = '', latestHistoryIds = [], busy = false, embedded = @Model.Embedded.ToString().ToLowerInvariant(), canApply = @Model.CanApply.ToString().ToLowerInvariant();
    var messageBox = document.getElementById('priceRunMessage');
    var catalogItems = [], catalogSelection = Object.create(null), catalogReady = false, catalogVersion = 0, loadedScope = '';
    function isCatalog() { return document.getElementById('priceSource').value === 'catalog'; }
    function selectedItems() { return isCatalog() ? catalogItems.filter(function (x) { return catalogSelection[x.MAHANG]; }) : importedItems; }
    function valueOf(obj, name) { if (!obj) return undefined; var key = Object.keys(obj).filter(function (k) { return k.toUpperCase() === name.toUpperCase(); })[0]; return key ? obj[key] : undefined; }
    function showMessage(text, kind) { messageBox.className = 'alert alert-' + (kind || 'info'); messageBox.textContent = text; messageBox.style.display = text ? 'block' : 'none'; }
    function money(value) { if (value === null || value === undefined || value === '') return '—'; return Number(value).toLocaleString('vi-VN', { maximumFractionDigits: 2 }); }
    function wholeMoney(value) { if (value === null || value === undefined || value === '') return ''; return Math.round(Number(value)).toLocaleString('vi-VN', { maximumFractionDigits: 0 }); }
    function parseWholeMoney(value) { var digits = String(value || '').replace(/[^0-9]/g, ''); return digits ? Number(digits) : NaN; }
    function dateText(value) { if (!value) return '—'; var s = String(value).substring(0, 10); var p = s.split('-'); return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : s; }
    function requestData() {
        var data = embedded ? window.priceFormulaEditor.batchScope() : { LOAIGIA: document.getElementById('priceType').value, ID_NHOMHANGHOAS: Array.prototype.map.call(document.querySelectorAll('#priceGroups input:checked'), function (x) { return x.value; }) };
        data.NGAYTINH = document.getElementById('priceDate').value; data.USE_EXCEL_PURCHASE_PRICE = !isCatalog(); data.ITEMS = selectedItems(); return data;
    }
    function invalidate() { previewSnapshot = ''; previewRows = []; document.getElementById('formulaList').textContent = 'Bấm Tính xem trước để xác định công thức phù hợp với phạm vi mới.'; document.getElementById('priceRows').innerHTML = '<tr><td colspan="14" class="pr-empty">Chưa có kết quả. Hãy bấm Tính xem trước.</td></tr>'; document.getElementById('exportResult').disabled = true; updateSummary(); }
    function resetCatalog() { catalogVersion++; catalogItems = []; catalogSelection = Object.create(null); catalogReady = false; document.getElementById('catalogOptions').textContent = 'Bấm Nạp danh sách để chọn từng hàng.'; document.getElementById('catalogChips').innerHTML = ''; document.getElementById('catalogSummary').textContent = 'Tất cả hàng hóa trong nhóm đã chọn'; invalidate(); }
    window.addEventListener('price-formula-changed', invalidate);
    window.addEventListener('price-formula-changed', function () { if (!loadedScope) return; var data = requestData(); if (loadedScope !== JSON.stringify([data.LOAIGIA, data.ID_NHOMHANGHOAS])) { loadedScope = ''; resetCatalog(); } });
    document.getElementById('priceDate').addEventListener('change', invalidate);
    if (!embedded) {
        document.getElementById('priceType').addEventListener('change', resetCatalog);
        var groupHost = document.getElementById('priceGroups');
        function groupChanged() {
            var checks = groupHost.querySelectorAll('input:checked'), chips = document.getElementById('priceGroupChips'); chips.innerHTML = '';
            document.getElementById('priceGroupSummary').textContent = checks.length ? checks.length + ' nhóm đã chọn' : 'Tất cả nhóm hàng hóa';
            checks.forEach(function (check) { var chip = document.createElement('button'); chip.type = 'button'; chip.className = 'pr-chip'; chip.textContent = check.dataset.label + ' ×'; chip.onclick = function () { check.checked = false; groupChanged(); }; chips.appendChild(chip); }); resetCatalog();
        }
        groupHost.addEventListener('change', groupChanged);
        document.getElementById('priceGroupSearch').addEventListener('input', function () { var q = this.value.toLocaleLowerCase(); groupHost.querySelectorAll('label').forEach(function (label) { label.style.display = label.textContent.toLocaleLowerCase().indexOf(q) >= 0 ? '' : 'none'; }); });
    }
    function renderCatalog() {
        var host = document.getElementById('catalogOptions'), chips = document.getElementById('catalogChips'); host.innerHTML = ''; chips.innerHTML = '';
        var count = 0;
        catalogItems.forEach(function (item) {
            var label = document.createElement('label'), check = document.createElement('input'); check.type = 'checkbox'; check.checked = !!catalogSelection[item.MAHANG];
            check.onchange = function () { catalogSelection[item.MAHANG] = check.checked; renderCatalog(); invalidate(); };
            label.appendChild(check); label.appendChild(document.createTextNode(item.MAHANG + ' · ' + item.TEN_HANG + ' · ' + money(item.GIAHIENTAI))); host.appendChild(label);
            if (check.checked) { count++; if (count <= 12) { var chip = document.createElement('button'); chip.type = 'button'; chip.className = 'pr-chip'; chip.textContent = item.MAHANG + ' ×'; chip.onclick = function () { catalogSelection[item.MAHANG] = false; renderCatalog(); invalidate(); }; chips.appendChild(chip); } }
        });
        document.getElementById('catalogSummary').textContent = count + '/' + catalogItems.length + ' hàng hóa đã chọn';
        if (!catalogItems.length) host.textContent = 'Không tìm thấy hàng hóa phù hợp.';
        if (count > 12) chips.appendChild(document.createTextNode('và ' + (count - 12) + ' hàng hóa khác'));
    }
    function loadCatalog() {
        var version = ++catalogVersion, data = requestData(); data.ITEMS = []; data.DRAFT_FORMULA = null; data.SEARCH = document.getElementById('catalogSearch').value;
        loadedScope = JSON.stringify([data.LOAIGIA, data.ID_NHOMHANGHOAS]);
        document.getElementById('loadCatalog').disabled = true;
        return postPayload('@Url.Action("CalculationProducts", "PriceFormula")', data, false).then(function (res) {
            if (version !== catalogVersion) throw new Error('Phạm vi đã đổi. Hãy nạp danh sách lại.');
            if (!valueOf(res, 'Success')) throw new Error(valueOf(res, 'Message') || 'Không tải được hàng hóa.');
            catalogItems = (valueOf(res, 'Data') || []).map(function (x) { return { MAHANG: valueOf(x, 'MAHANG'), TEN_HANG: valueOf(x, 'TEN_HANG'), GIAHIENTAI: valueOf(x, 'GIAHIENTAI') }; });
            catalogSelection = Object.create(null); catalogItems.forEach(function (x) { catalogSelection[x.MAHANG] = true; }); catalogReady = true; renderCatalog(); invalidate();
        }).finally(function () { document.getElementById('loadCatalog').disabled = false; });
    }
    document.getElementById('catalogSearch').addEventListener('input', resetCatalog);
    document.getElementById('loadCatalog').onclick = function () { loadCatalog().catch(function (e) { showMessage(e.message, 'danger'); }); };
    function selectAllCatalog(selected) {
        var applySelection = function () { catalogItems.forEach(function (x) { catalogSelection[x.MAHANG] = selected; }); renderCatalog(); invalidate(); };
        if (catalogReady) { applySelection(); return; }
        loadCatalog().then(applySelection).catch(function (e) { showMessage(e.message, 'danger'); });
    }
    document.getElementById('allCatalog').onclick = function () { selectAllCatalog(true); };
    document.getElementById('clearAllCatalog').onclick = function () { selectAllCatalog(false); };
    document.getElementById('priceSource').addEventListener('change', function () { document.getElementById('catalogScope').style.display = isCatalog() ? '' : 'none'; invalidate(); document.getElementById('previewPrices').disabled = busy || (!isCatalog() && !importedItems.length); });
    function loadXlsx() { if (window.XLSX) return Promise.resolve(); if (window.xlsxLoadPromise) return window.xlsxLoadPromise; window.xlsxLoadPromise = new Promise(function (resolve, reject) { var script = document.createElement('script'); script.src = 'https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js'; script.onload = resolve; script.onerror = function () { window.xlsxLoadPromise = null; reject(new Error('Không tải được thư viện đọc Excel.')); }; document.head.appendChild(script); }); return window.xlsxLoadPromise; }
    function headerKey(value) { return String(value || '').toUpperCase().replace(/[ _-]/g, ''); }
    function parseExcelPrice(value) { if (typeof value === 'number') return value; var text = String(value || '').trim().replace(/\s/g, ''); if (!text) return 0; if (/^-?\d{1,3}(\.\d{3})+(,\d+)?$/.test(text)) text = text.replace(/\./g, '').replace(',', '.'); else if (text.indexOf(',') >= 0 && text.indexOf('.') < 0) text = text.replace(',', '.'); else text = text.replace(/,/g, ''); var n = Number(text); return isFinite(n) ? n : NaN; }
    document.getElementById('downloadTemplate').onclick = function () { loadXlsx().then(function () { var ws = XLSX.utils.aoa_to_sheet([['MAHANG', 'TEN HANG', 'GIAHIENTAI'], ['SP001', 'Sản phẩm mẫu', 100000]]); var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, 'DanhSachGia'); XLSX.writeFile(wb, 'Mau_TinhGia.xlsx'); }).catch(function (e) { showMessage(e.message, 'danger'); }); };
    document.getElementById('excelFile').addEventListener('change', function () {
        var file = this.files && this.files[0]; importedItems = []; invalidate(); document.getElementById('priceSource').value = 'excel'; document.getElementById('catalogScope').style.display = 'none'; document.getElementById('previewPrices').disabled = true;
        showMessage('', 'info');
        if (!file) return;
        loadXlsx().then(function () { return file.arrayBuffer(); }).then(function (buffer) {
            var book = XLSX.read(buffer, { type: 'array' }); var sheet = book.Sheets[book.SheetNames[0]]; var rows = XLSX.utils.sheet_to_json(sheet, { defval: '', raw: true });
            if (!rows.length) throw new Error('File Excel chưa có dòng dữ liệu.');
            var keys = Object.keys(rows[0]), map = {}; keys.forEach(function (key) { map[headerKey(key)] = key; });
            if (!map.MAHANG || !map.TENHANG || !map.GIAHIENTAI) throw new Error('Thiếu cột bắt buộc: MAHANG, TEN HANG, GIAHIENTAI.');
            importedItems = rows.filter(function (r) { return String(r[map.MAHANG] || '').trim(); }).map(function (r) { var price = parseExcelPrice(r[map.GIAHIENTAI]); if (!isFinite(price) || price <= 0) throw new Error('Giá nhập gốc (GIAHIENTAI) phải lớn hơn 0 ở mã hàng ' + r[map.MAHANG] + '.'); return { MAHANG: String(r[map.MAHANG]).trim(), TEN_HANG: String(r[map.TENHANG] || '').trim(), GIAHIENTAI: price }; });
            if (!importedItems.length) throw new Error('Không tìm thấy mã hàng trong file.');
            if (importedItems.length > 1000) throw new Error('Tối đa 1.000 hàng hóa mỗi lần.');
            var seen = {}; importedItems.forEach(function (x) { var key = x.MAHANG.toUpperCase(); if (seen[key]) throw new Error('File bị trùng mã hàng: ' + x.MAHANG); seen[key] = true; });
            document.getElementById('fileSummary').textContent = 'Đã đọc ' + importedItems.length + ' hàng hóa từ ' + file.name + '.';
            document.getElementById('previewPrices').disabled = false;
        }).catch(function (e) { importedItems = []; document.getElementById('fileSummary').textContent = ''; showMessage(e.message || 'Không đọc được file Excel.', 'danger'); });
    });
    function postPayload(url, data, includeToken) {
        var fields = new URLSearchParams(); fields.append('payload', JSON.stringify(data));
        if (includeToken) fields.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);
        return fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'Accept': 'application/json' }, body: fields.toString() }).then(function (r) { return r.json(); });
    }
    function loadLatestRestore() {
