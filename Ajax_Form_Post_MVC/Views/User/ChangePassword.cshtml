@model MVC_QuanLyTHP.Controllers.ChangePassword
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
<hr />
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="panel-group" id="accordion">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h1 class="panel-title" style="text-align:center">
                    <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                        Đổi mật khẩu
                    </a>
                </h1>
            </div>
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <label class="text-danger">* Lưu ý: Mật khẩu phải có ít nhất 10 ký tự, trong đó có ít nhất 1 chữ hoa, ít nhất 1 chữ thường, ít nhất một số và một ký tự đặc biệt.</label>
            <div id="collapseOne" class="panel-collapse collapse in">
                <div class="panel-body panel-body-nopadding">
                    <div class="form-horizontal form-bordered">

                        <div class="form-group">
                            <label class="col-sm-2 control-label"> Mật khẩu cũ:</label>
                            <div class="col-sm-5">
                                @Html.PasswordFor(m => m.Password, new { value = Model.Password, @class = "form-control pword", @placeholder = "Mật khẩu cũ" } )
                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label"> Mật khẩu mới:</label>
                            <div class="col-sm-5">
                                @Html.PasswordFor(m => m.NewPassword, new { value = Model.Password, @class = "form-control pword", @placeholder = "Mật khẩu mới" } )
                                @Html.ValidationMessageFor(model => model.NewPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-2 control-label"> Nhập lại mật khẩu:</label>
                            <div class="col-sm-5">
                                @Html.PasswordFor(m => m.ConfirmPassword, new { value = Model.Password, @class = "form-control pword", @placeholder = "Mật khẩu xác nhận" } )
                                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                </div>
            </div>
        </div>
    </div>
}
