@model MVC_QuanLyTHP.Models.v_v_nv_PhepNam
@using DatabaseTHP;
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using MVC_QuanLyTHP.Models;
@using Newtonsoft.Json;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<hr />
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOneDebt">
                    @Utility.GetTitleFrom(API.nv_PhepNam)
                </a>
            </h1>
        </div>


        <div id="collapseOneDebt" class="panel-collapse collapse in">
            <div class="panel-body panel-body-nopadding">
                <div class="form-horizontal form-bordered">
                    <div class="form-group">
                        <div class="col-sm-3" style="padding-bottom: 5px;">
                            <button id="download-excel" style="background-color: #217346;" class="btn btn-success" onclick="ExportExcel('example-table')"><i class="fa fa-file-text-o" style="margin-right:10px"></i>@Utility.XuatExcel</button>
                            @if (ViewBag.PermissionCreate)
                            {
                                if (Utility.IntWidth == 1)
                                {
                                    <button class="btn btn-success" onclick="myFunctionCreate('@{@API.nv_PhepNam;}')"><i class="fa fa-pencil-square-o" style="margin-right:10px"></i>@Utility.Them</button>
                                }
                                else
                                {
                                    <a class="btn btn-success" href="@Url.Action("Create", API.nv_PhepNam)"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</a>
                                }
                            }
                        </div>
                    </div>
                    <div class="col-sm-2" style="padding-bottom: 5px;">
                        <select class="form-control chosen-select" onchange="show('@{@API.nv_PhepNam;}')" id="Show" name="Show">
                            @for (int show = 0; show < Utility.arrShow.Length; show++)
                            {
                                if (Utility.GetPageSize() == @Utility.arrShow[show])
                                {
                                    <option value="@Utility.arrShow[show]" selected>@Utility.arrShow[show]</option>
                                }
                                else
                                {
                                    <option value="@Utility.arrShow[show]">@Utility.arrShow[show]</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-2" style="padding-bottom: 5px;">
                        <select class="form-control chosen-select" id="ShowSearchValue" name="ShowSearchValue">
                            @for (int show = 0; show < Utility.listSearch.Count; show++)
                            {
                                if (ViewBag.showsearchValue == Utility.listSearch[show].Item1)
                                {
                                    <option value="@Utility.listSearch[show].Item1" selected>@Utility.listSearch[show].Item2</option>
                                }
                                else
                                {
                                    <option value="@Utility.listSearch[show].Item1">@Utility.listSearch[show].Item2</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBox("SearchString", (string)ViewBag.searchValue, htmlAttributes: new { @class = "form-control", @style = "width:80%;display:inline-block", @placeholder = Utility.TimKiem })
                        <button class="btn btn-default" onclick="funSearchItem('@{@API.nv_PhepNam;}')"><span class='glyphicon glyphicon-search'></span></button>
                    </div>

                </div>
            </div>

            <div style="overflow-x: auto; Overflow-y: scroll; height: 500px;">
                <div class="panel-body panel-body-nopadding">
                    <div class="form-horizontal form-bordered">
                        <table class="table table-bordered mb30" id="example-table">
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_PhepNam, "NAM")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_KhachHang, "MA")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_KhachHang, "NAME")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_PhepNam, "SONGAYPHEP")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_PhepNam, "SONGAYPHEPDADUNG")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_PhepNam, "NGAYBATDAU")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_PhepNam, "NGAYKETTHUC")</th>
                                    <th>

                                    </th>
                                </tr>
                            </thead>

                            @{
                                if (Model.IPagedList != null && Model.IPagedList.Count() > 0)
                                {
                                    <tbody id="tbodytmpitem">

                                        @foreach (var item in Model.IPagedList)
                                        {
                                            string NGAYBATDAU = item.NGAYBATDAU != null ? item.NGAYBATDAU.ToString("dd/MM/yyyy") : "";
                                            string NGAYKETTHUC = item.NGAYKETTHUC != null ? item.NGAYKETTHUC.ToString("dd/MM/yyyy") : "";
                                            <tr id="@item.ID">
                                                <td style="white-space: nowrap; " id="NAM"> @Html.DisplayFor(modelItem => item.NAM)</td>
                                                <td style="white-space: nowrap; " id="MA"> @Html.DisplayFor(modelItem => item.MA_NHANVIEN)</td>
                                                <td style="white-space: nowrap; " id="NAME_NHANVIEN"> @Html.DisplayFor(modelItem => item.NAME_NHANVIEN)</td>
                                                <td style="white-space: nowrap; " id="SONGAYPHEP"> @Html.DisplayFor(modelItem => item.SONGAYPHEP)</td>
                                                <td style="white-space: nowrap; " id="SONGAYPHEPDADUNG"> @Html.DisplayFor(modelItem => item.SONGAYPHEPDADUNG)</td>
                                                <td style="white-space: nowrap; text-align: right;" id="NGAYBATDAU"> @NGAYBATDAU</td>
                                                <td style="white-space: nowrap; text-align: right;" id="NGAYKETTHUC"> @NGAYKETTHUC</td>
                                                <td style="white-space: nowrap; " class="fix">
                                                    @if (ViewBag.PermissionEdit)
                                                    {
                                                        if (Utility.IntWidth == 1)
                                                        {
                                                            <a class="label label-primary" onclick="myFunctionEdit('@{@API.nv_PhepNam;}','@item.ID')" href="#"><i class="fa fa-edit" style="margin-right:5px"></i>@Utility.Sua</a>
                                                        }
                                                        else
                                                        {
                                                            @Html.ActionLink(Utility.Sua, "Edit", new { id = item.ID }, htmlAttributes: new { @class = "label label-primary" });
                                                        }
                                                    }
                                                    @if (ViewBag.PermissionDelete)
                                                    {
                                                        if (Utility.IntWidth == 1)
                                                        {
                                                            <a class="label label-danger" onclick="myFunctionPopup('@{@API.nv_PhepNam;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                        }
                                                        else
                                                        {
                                                            <a class="label label-danger" onclick="myFunction('@{@API.nv_PhepNam;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                        }

                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            }
                        </table>
                    </div>
                </div><!-- table-responsive -->
            </div>


        </div>
        <div class="panel-footer">
        </div>
    </div>
</div>

@if (Utility.IntWidth == 1)
{
    if (ViewBag.PermissionCreate)
    {
        <button id="myBtnAdd" style="display:none"></button>
        <div id="myModalAdd" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Create", @API.nv_PhepNam, new { type = 1 });}
            </div>
        </div>
    }
    if (ViewBag.PermissionEdit)
    {
        <button id="myBtnEdit" style="display:none"></button>
        <div id="myModalEdit" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Edit", @API.nv_PhepNam, new { type = 1, id = "" });}
            </div>
        </div>
    }
}  