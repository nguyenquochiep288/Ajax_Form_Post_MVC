    <style>
        body .btn {
            display: inline-flex;
            min-height: 40px;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 8px 14px;
            border: 1px solid transparent;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(15, 23, 42, .10);
            font-weight: 600;
            line-height: 1.25;
            text-decoration: none;
            transition: background-color .18s ease, border-color .18s ease, box-shadow .18s ease, transform .18s ease;
        }

        body .btn:hover {
            box-shadow: 0 4px 10px rgba(15, 23, 42, .16);
            transform: translateY(-1px);
        }

        body .btn:focus {
            outline: 3px solid rgba(15, 118, 110, .20);
            outline-offset: 2px;
        }

        body .btn-success {
            border-color: #16a996;
            background-color: #16a996;
            color: #fff;
        }

        body .btn-success:hover,
        body .btn-success:focus {
            border-color: #108f81;
            background-color: #108f81;
            color: #fff;
        }

        body .btn-primary {
            border-color: #2563eb;
            background-color: #2563eb;
            color: #fff;
        }

        body .btn-primary:hover,
        body .btn-primary:focus {
            border-color: #1d4ed8;
            background-color: #1d4ed8;
            color: #fff;
        }

        body .btn-danger {
            border-color: #dc3545;
            background-color: #dc3545;
            color: #fff;
        }

        body .btn-danger:hover,
        body .btn-danger:focus {
            border-color: #b02a37;
            background-color: #b02a37;
            color: #fff;
        }

        body .btn-default {
            border-color: #cbd5e1;
            background-color: #f8fafc;
            color: #334155;
        }

        body .btn-default:hover,
        body .btn-default:focus {
            border-color: #94a3b8;
            background-color: #e2e8f0;
            color: #0f172a;
        }

        body .btn-warning {
            border-color: #d97706;
            background-color: #d97706;
            color: #fff;
        }

        body .btn-info {
            border-color: #0891b2;
            background-color: #0891b2;
            color: #fff;
        }

        body .btn-sm,
        body .btn-xs {
            min-height: 32px;
            padding: 6px 10px;
            border-radius: 7px;
        }

        body #download-excel {
            border-color: #217346 !important;
            background-color: #217346 !important;
            color: #fff !important;
        }

        body #download-excel:hover,
        body #download-excel:focus {
            border-color: #185c37 !important;
            background-color: #185c37 !important;
            color: #fff !important;
        }

        #backToTop {
            position: fixed;
            right: 22px;
            bottom: 22px;
            z-index: 1100;
            display: grid;
            width: 50px;
            height: 50px;
            place-items: center;
            border: 0;
            border-radius: 50%;
            background: #0f766e;
            color: #fff;
            box-shadow: 0 5px 18px rgba(15, 23, 42, .25);
            font-size: 28px;
            line-height: 1;
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: opacity .2s ease, transform .2s ease, background-color .2s ease, visibility .2s;
            cursor: pointer;
        }

        #backToTop.is-visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        #backToTop:hover,
        #backToTop:focus {
            background: #115e59;
            color: #fff;
            outline: 3px solid rgba(15, 118, 110, .25);
            outline-offset: 2px;
        }

        @@media (max-width: 767px) {
            #backToTop {
                right: 16px;
                bottom: 16px;
                width: 48px;
                height: 48px;
            }
        }
    </style>

