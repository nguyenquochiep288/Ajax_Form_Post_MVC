<script type="text/javascript">
    function GetWidth() {
        $.post("/" + "Admin/GetWidth", { "Width": $(window).width() }, function (data) {
        });

        // Basic Slider
        jQuery('#slider').slider({
            range: "min",
            max: 100,
            value: 50
        });

        // Chosen Select
        jQuery(".chosen-select").chosen({ 'width': '100%', 'white-space': 'nowrap' });

        // Date Picker
        jQuery('#datepicker').datepicker();

    };
    function loadXlsx() {
        if (window.XLSX) {
            return Promise.resolve();
        }
        if (!window.xlsxLoadPromise) {
            window.xlsxLoadPromise = new Promise(function (resolve, reject) {
                var script = document.createElement('script');
                script.src = 'https://cdn.sheetjs.com/xlsx-0.19.3/package/dist/xlsx.full.min.js';
                script.onload = resolve;
                script.onerror = function () {
                    window.xlsxLoadPromise = null;
                    reject(new Error('Không tải được thư viện Excel.'));
                };
                document.head.appendChild(script);
            });
        }
        return window.xlsxLoadPromise;
    }

    function ExportExcel(nametable) {
        var table = document.getElementById(nametable);
        if (!table) {
            return;
        }

        loadXlsx().then(function () {
            const wb = XLSX.utils.table_to_book(table, { sheet: 'Sheet1' });
            const ws = wb.Sheets['Sheet1'];
            for (let cell in ws) {
                if (ws[cell].t === 'n') {
                    ws[cell].z = '#,##0.00';
                }
            }

            XLSX.writeFile(wb, 'FileExportExcel.xlsx');
        }).catch(function () {
            alert('Không thể tải thư viện xuất Excel. Vui lòng thử lại.');
        });
    }
</script>

