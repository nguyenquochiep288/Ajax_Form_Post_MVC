        //        rowContent.push(cells[j].innerText.replaceAll(',',';'));
        //    }
        //    csvContent += rowContent.join(',') + '\n'; // Use semicolon as delimiter
        //}

        //var blob = new Blob([csvContent], {type: 'text/csv;charset=utf-8;' });
        //var url = window.URL.createObjectURL(blob);
        //var a = document.createElement('a');
        //a.setAttribute('hidden', '');
        //a.setAttribute('href', url);
        //a.setAttribute('download', 'FileExportExcel.csv');
        //document.body.appendChild(a);
        //a.click();
        //document.body.removeChild(a);
        const table = document.getElementById(nametable);
        const wb = XLSX.utils.table_to_book(table, { sheet: 'Sheet1' });

        // Format cells as currency (VND)
        const ws = wb.Sheets['Sheet1'];
        for (let cell in ws) {
            if (ws[cell].t === 'n') { // Check if the cell is a number
                ws[cell].z = '#,##0.00'; // Apply VND currency format
            }
        }

        XLSX.writeFile(wb, 'FileExportExcel.xlsx');
    }
</script>

