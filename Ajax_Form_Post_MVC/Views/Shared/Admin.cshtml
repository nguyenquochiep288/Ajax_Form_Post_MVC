<script type="text/javascript">
    function GetWidth() {
        $.post("/" + "Admin/GetWidth", { "Width": $(window).width() }, function (data) {
        });

        // Basic Slider
        jQuery('#slider').slider({
            range: "min",
            max: 100,
            value: 50
        });

        // Chosen Select
        jQuery(".chosen-select").chosen({ 'width': '100%', 'white-space': 'nowrap' });

        // Date Picker
        jQuery('#datepicker').datepicker();

    };
    function ExportExcel(nametable) {
