@model MVC_QuanLyTHP.Models.v_v_AspNetUsers
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;

@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("CreatePopup", API.AspNetUser, new AjaxOptions {OnBegin = "OnBegin", OnSuccess = "OnSuccessCreate" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel-heading" style="padding-top:15px;padding-right: 15px;">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalAdd")'>&times;</a>
            </div>

            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.AspNetUser)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.ID)
        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "UserName"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "PasswordDecrypt"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.PasswordFor(model => model.Password, new { @class = "form-control pword" })
                        @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "FullName"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "Email"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", title = "A valid email address is required (i.e. user@domain.com)" } })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "PhoneNumber"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "LockoutEnabled"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.LockoutEnabled, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.LockoutEnabled, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "ID_NHOMQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        <div class="input-group mb15">
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" onclick="myFunOpenSearch('myModalAdd', '@{@API.web_NhomQuyen;}', '@API.Chon1', 'lstweb_NhomQuyen', '')"><span class="glyphicon glyphicon-search"></span></button>
                            </span>
                            @Html.DropDownListFor(model => model.ID_NHOMQUYEN, new SelectList(Model.lstweb_NhomQuyen, "ID", "NAME"), Utility.GetTitleChon(API.web_NhomQuyen), htmlAttributes: new { @class = "form-control", id = "lstweb_NhomQuyen" })
                        </div>
                       
                        @Html.ValidationMessageFor(model => model.ID_NHOMQUYEN, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalAdd")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                            @Utility.GetTitleFrom(API.AspNetUser)
                        </a>
                    </h1>
                </div>

                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div id="collapseOne" class="panel-collapse collapse in">
                    <div class="form-horizontal form-bordered">
                        @Html.HiddenFor(model => model.ID)


                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "UserName"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.UserName, new { htmlAttributes = new { @class = "form-control uname" } })
                                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "PasswordDecrypt"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.PasswordFor(model => model.Password, new { @class = "form-control pword" })
                                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "FullName"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.FullName, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.FullName, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "Email"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control", title = "A valid email address is required (i.e. user@domain.com)" } })
                                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "PhoneNumber"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.PhoneNumber, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.PhoneNumber, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "LockoutEnabled"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.CheckBoxFor(model => model.LockoutEnabled, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.LockoutEnabled, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.AspNetUser, "ID_NHOMQUYEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.DropDownListFor(model => model.ID_NHOMQUYEN, new SelectList(Model.lstweb_NhomQuyen, "ID", "NAME"), Utility.GetTitleChon(API.web_NhomQuyen), htmlAttributes: new { @class = "form-control chosen-select", id = "lstweb_NhomQuyen" })
                                @Html.ValidationMessageFor(model => model.ID_NHOMQUYEN, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-2">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                            @if (Request.UrlReferrer != null)
                            {
                                <a href="@Request.UrlReferrer.ToString()">@Utility.QuayLai</a>
                            }
                            else
                            {
                                @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    if (ViewBag.ID != null && !string.IsNullOrEmpty(ViewBag.ID))
    {
        <script>
      var x = document.getElementById("ID");
      x.value = '@ViewBag.ID';
        </script>
    }
}

