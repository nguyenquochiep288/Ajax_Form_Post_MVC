@model MVC_QuanLyTHP.Models.v_v_Search
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
<button id="myBtnSearch" style="display:none"></button>
<div id="myModalSearch" class="modal">
    <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level2)>
        <!-- The Modal -->
        <div class="panel-heading" style="padding-top:15px;padding-right: 15px;">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalSearch")'>&times;</a>
            </div>

            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblNameSearch" name="lblNameSearch">@Utility.GetTitleFrom(API.web_Menu)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>

        </div>

        <div class="panel-body panel-body-nopadding">

            <div class="form-horizontal form-bordered">
                @using (Ajax.BeginForm("Search", API.Search, new AjaxOptions { OnSuccess = "OnSuccessSearch" }))
                {
                    <input type="hidden" id="HinhThucTimKiemSearch" name="HinhThucTimKiem" />
                    <input type="hidden" id="MyModalSearch" name="MyModal" />
                    <input type="hidden" id="ClassNameSearch" name="ClassName" />
                    <input type="hidden" id="ValueFieldSearch" name="ValueField" />
                    <input type="hidden" id="TextFieldSearch" name="TextField" />
                    <input type="hidden" id="ValueSelectedSearch" name="ValueSelected" />
                    <input type="hidden" id="ID_KHOSEARCH" name="ID_KHO" />
                    <div class="form-group">
                        <div class="col-sm-2" style="padding-bottom: 5px;">
                            <select class="form-control chosen-select" id="ShowSearchValueSearch" name="ShowSearchValue">
                                @for (int show = 0; show < Utility.listSearch.Count; show++)
                                {
                                    if (ViewBag.showsearchValue == Utility.listSearch[show].Item1)
                                    {
                                        <option value="@Utility.listSearch[show].Item1" selected>@Utility.listSearch[show].Item2</option>
                                    }
                                    else
                                    {
                                        <option value="@Utility.listSearch[show].Item1">@Utility.listSearch[show].Item2</option>
                                    }
                                }
                            </select>

                        </div>
                        <div class="col-sm-4">
                            @Html.TextBox("SearchString", (string)ViewBag.searchValue, htmlAttributes: new { @class = "form-control", @style = "width:80%;display:inline-block", @placeholder = Utility.TimKiem, id = "SearchStringSearch" })
                            <button class="btn btn-default" id="ButtonClick"><span class='glyphicon glyphicon-search'></span></button>
                        </div>
                    </div>
                }

                <div style="overflow-x:auto; Overflow-y:scroll; height: 400px;">
                    <div class="panel-body panel-body-nopadding">
                        <div class="form-horizontal form-bordered">
                            <table class="table table-bordered mb30">
                                <thead>
                                    <tr id="trSearch">

                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="tbodySearch">
                                </tbody>
                            </table>
                        </div>
                    </div><!-- table-responsive -->
                </div>
            </div>

        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalSearch")'>@Utility.Dong</a>
                </div>
            </div>
        </div>
    </div>
</div>

<button id="myBtnCombo" style="display:none"></button>
<!-- The Modal -->
<div id="myModalCombo" class="modal">
    <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level3)>
        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalCombo")'>&times;</a>
            </div>
            <h1 class="panel-title"><label id="lblNameCombo" name="lblNameCombo" style="font-size: 20px; font-weight: bold;"></label></h1>
        </div>
        @using (Ajax.BeginForm("AddProductCombo", API.dm_HangHoa_Combo, new AjaxOptions { OnSuccess = "OnSuccessProductCombo" }))
        {
            <div class="panel-body panel-body-nopadding">
                <div class="form-horizontal form-bordered">
                    <input type="hidden" name="ID_HANGHOA" id="idProductCombo" />
                    <input type="hidden" name="PriceProduct" id="PriceProduct" />
                    <input type="hidden" name="PriceProduct_QD" id="PriceProduct_QD" />
