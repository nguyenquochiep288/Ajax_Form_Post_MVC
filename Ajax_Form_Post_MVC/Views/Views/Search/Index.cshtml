                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Đơn giá:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="Price" id="PriceProductCombo" disabled="disabled" min="1" step="any" data-type="currency" visibility="" />
                        </div>
                    </div>
                    <div class="form-group">
