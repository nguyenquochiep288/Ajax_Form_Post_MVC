<button id="myBtnInputOutput" style="display:none"></button>
<!-- The Modal -->
<div id="myModalInputOutput" class="modal">
    <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level3)>
        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalInputOutput")'>&times;</a>
            </div>
            <h1 class="panel-title"><label id="lblNameInputOutput" name="lblNameInputOutput" style="font-size: 20px; font-weight: bold;"></label></h1>
        </div>
        @using (Ajax.BeginForm("AddProductInputOutput", API.dm_HangHoa, new AjaxOptions { OnSuccess = "OnSuccessProductInputOutput" }))
        {
            <div class="panel-body panel-body-nopadding">
                <div class="form-horizontal form-bordered">
                    <input type="hidden" name="ID_KHO" id="idDepotInputOutput" />
                    <input type="hidden" name="ID_HANGHOA" id="idProductInputOutput" />
                    <input type="hidden" name="ID_HANGHOAKHO" id="idProductKhoInputOutput" />
                    <input type="hidden" name="DONGIAInputOutput" id="PriceInputOutput" />
                    <input type="hidden" name="DONGIA_QDInputOutput" id="Price_QDInputOutput" />
                    <input type="hidden" name="THUESUAT" id="THUESUATProductInputOutput" />
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Đơn vị tính:</label>
                        <div class="col-sm-2">
                            <input type="radio" id="ID_DVTInputOutput" name="ID_DVT" value="HTML" onclick="ShowHideDivInputOutput()" onchange="updateAddProduct(this)"><label id="lblID_DVTInputOutput" style="padding-left:10px">HTML</label>
                        </div>
                        <div class="col-sm-2">
                            <input type="radio" id="ID_DVT_QDInputOutput" name="ID_DVT" value="HTML" onclick="ShowHideDivInputOutput()" onchange="updateAddProduct(this)"><label id="lblID_DVT_QDInputOutput" style="padding-left:10px">HTML</label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Số lượng:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="SOLUONG" id="QtyProductInputOutput" min="1" step="any" data-type="currency" onchange="updateAddProduct(this)" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Đơn giá:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="DONGIA" id="PriceProductInputOutput" min="0" step="any" data-type="currency" onchange="updateAddProduct(this)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">%CKGG:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="CHIETKHAU" id="DiscountProductInputOutput" min="0" max="100" step="any" data-type="currency" onchange="updateAddProduct(this)" />
                        </div>
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Tiền CKGG:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="TONGTIENGIAMGIA" id="PriceDiscountProductInputOutput" min="0" step="any" data-type="currency" onchange="updateAddProduct(this)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Thành tiền:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="THANHTIEN" id="IntoMoneyProductInputOutput" min="0" step="any" data-type="currency" readonly="readonly" onchange="updateAddProduct(this)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">VAT:</label>
                        <div class="col-sm-2">
                            @Html.DropDownList("ID_THUESUAT", new SelectList(Model.lstdm_ThueSuat, "ID", "NAME"), Utility.GetTitleChon(API.dm_ThueSuat), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_ThueSuatSearch", onchange = "updateAddProduct(this)" })
                        </div>
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Tiền thuế:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="TONGTIENVAT" id="TaxMoneyProductInputOutput" min="0" step="any" data-type="currency" onchange="updateAddProduct(this)" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label" for="disabledinput" style="width:100px">Tổng tiền:</label>
                        <div class="col-sm-2">
                            <input type="number" class="form-control mask" name="TONGCONG" id="TotalProductInputOutput" min="0" step="any" data-type="currency" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div><!-- panel-body -->

            <div class="panel-footer">
                <div class="row">
                    <div class="col-sm-6 col-sm-offset-4">
                        <button class="btn btn-primary" onclick="validatetext()">@Utility.ThucHien</button>
                        <a class="btn btn-default" onclick='myFunClosed("myModalInputOutput")'>Cancel</a>
                    </div>
                </div>
            </div>
        }
    </div><!-- panel -->
</div>

