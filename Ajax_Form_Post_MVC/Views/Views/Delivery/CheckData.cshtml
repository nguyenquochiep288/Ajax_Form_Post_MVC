@model DatabaseTHP.v_ct_PhieuGiaoHang
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<script src="@Url.Content("~/Scripts/InputOutput.js")"></script>
<script src="@Url.Content("~/Scripts/Delivery.js")"></script>
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                    @Utility.GetTitleFrom(API.ct_PhieuGiaoHang)
                </a>
            </h1>
        </div>


        <div id="collapseOne" class="panel-collapse collapse in">
            <div class="form-group">
                @Html.Label(@Utility.GetColumnName(@API.ct_PhieuGiaoHang, "MAPHIEU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                <div class="col-sm-2">
                    @Html.EditorFor(model => model.MAPHIEU, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                </div>
                @Html.Label(@Utility.GetColumnName(@API.ct_PhieuGiaoHang, "NGAYLAP"), htmlAttributes: new { @class = "col-sm-1 control-label" })
                <div class="col-sm-2">
                    @Html.TextBoxFor(model => model.NGAYLAP, (Model.NGAYLAP).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group">
                @Html.Label(@Utility.GetColumnName(@API.ct_PhieuGiaoHang, "ID_XEGIAOHANG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                <div class="col-sm-5">
                    @Html.EditorFor(model => model.NAME_XE, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                    
                </div>
            </div>

            <div class="form-group">
                @Html.Label(@Utility.GetColumnName(@API.ct_PhieuGiaoHang, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                <div class="col-sm-5">
                    @Html.TextAreaFor(model => model.GHICHU, new { @class = "form-control", @rows = "3", @readonly = "readonly" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-5" style="width:100%">
                    <h5 class="subtitle">Danh sách nhân viên giao hàng: </h5>
                    <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                        <div class="panel-body panel-body-nopadding">
                            <div class="form-horizontal form-bordered">
                                <table class="table table-bordered mb30">
                                    <thead>
                                        <tr>
                                            <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_NhanVienGiao, "MA_NHANVIEN")</th>
                                            <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_NhanVienGiao, "NAME_NHANVIEN")</th>
                                        </tr>
                                    </thead>
                                    <tbody id="lstct_PhieuGiaoHang_NhanVienGiaoEdit">
                                        @if (Model.lstct_PhieuGiaoHang_NhanVienGiao != null)
                                        {
                                            foreach (var item in Model.lstct_PhieuGiaoHang_NhanVienGiao)
                                            {
                                            <tr id="@item.ID">
                                                <td style="white-space: nowrap;" id="MA_NHANVIEN"> @Html.DisplayFor(modelItem => item.MA_NHANVIEN)</td>
                                                <td style="white-space: nowrap;" id="NAME_NHANVIEN">  @Html.DisplayFor(modelItem => item.NAME_NHANVIEN)</td>

                                            </tr>
                                            }
                                        }
                                        </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                <h5 class="subtitle">Danh sách phiếu xuất: </h5>
                <div class="panel-body panel-body-nopadding">
                    <table class="table table-bordered mb30">
                        <thead>
                            <tr>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "MAPHIEU")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "NGAYLAP")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "NAME_KHACHHANG_NCC")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "SOTIENGIAOHANG")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "SOTIENDATHU")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "INTPRINT")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "ISDAGIAOHANG")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuGiaoHang_ChiTiet, "GHICHU")</th>
                                <th>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="tbodytmpitem">
                            @if (Model.lstct_PhieuGiaoHang_ChiTiet != null)
                            {
                                foreach (var item in Model.lstct_PhieuGiaoHang_ChiTiet)
                                {
                                    string SOTIENGIAOHANG = item.SOTIENGIAOHANG.ToString("N0");
                                    string SOTIENDATHU = item.SOTIENDATHU.ToString("N0");
                                    <tr id="@item.ID">
                                        <td style="white-space: nowrap;" id="MAPHIEU"> @Html.DisplayFor(modelItem => item.MAPHIEU)</td>
                                        <td style="white-space: nowrap;" id="NGAYLAP"> @item.NGAYLAP.ToString("dd/MM/yy HH:mm")</td>
                                        <td style="white-space: nowrap;" id="NAME_KHACHHANG_NCC"> @Html.DisplayFor(model => item.NAME_KHACHHANG_NCC)</td>
                                        <td style="white-space: nowrap;" id="SOLUONG_DONHANG"> @SOTIENGIAOHANG </td>
                                        <td style="white-space: nowrap;" id="SOTIENDATHU">
                                            @SOTIENDATHU
                                            @if (!item.ISDAGIAOHANG)
                                            {
                                                <a class="label label-success" onclick="myFunctionCreateReceiptDelivery('@{@API.ct_PhieuThu;}', '@ViewBag.ID_LOAIPHIEUTHU','@item.ID_KHACHHANG_NCC','@item.MAPHIEU')" href="#"><i class="fa fa-pencil-square-o" style="margin-right:5px"></i>@Utility.Them</a>
                                            }
                                        </td>
                                        }

                                        <td style="white-space: nowrap;" id="INTPRINT">
                                            @if (Utility.IntWidth == 1)
                                            {
                                                <a class="label label-default" onclick="myFunctionEdit('@{@API.ct_PhieuGiaoHang;}','@item.ID')" href="#"><i class="fa fa-print" style="margin-right:5px"></i>@Utility.In @(item.INTPRINT > 0 ? " (" +  item.INTPRINT + ")" : "")</a>
                                            }
                                        </td>

                                        @if (!item.ISDAGIAOHANG)
                                        {
                                            <td style="white-space: nowrap;">
                                                <a class="label label-primary" href="@Url.Action("Completed", API.ct_PhieuGiaoHang, new { ID = item.ID } )"><i class="glyphicon glyphicon-check" style="margin-right:5px"></i>@Utility.HoanTat</a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td style="white-space: nowrap;" id="ISDAGIAOHANG"> @Html.DisplayFor(modelItem => item.ISDAGIAOHANG)</td>
                                        }
                                        <td style="white-space: nowrap;" id="GHICHU"> @Html.DisplayFor(modelItem => item.GHICHU)</td>
                                    </tr>
                                }
                            }
                    </table>
                </div>
            </div><!-- table-responsive -->
        </div>

        <div class="panel-footer">

        </div>
    </div>
</div>

@if (Utility.IntWidth == 1)
{
    <button id="myBtnAdd" style="display:none"></button>
    <div id="myModalAdd" class="modal" style="">
        <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
            <!-- The Modal -->
            @{Html.RenderAction("Create", @API.ct_PhieuThu, new { type = 1 });}
        </div>
    </div>
}
