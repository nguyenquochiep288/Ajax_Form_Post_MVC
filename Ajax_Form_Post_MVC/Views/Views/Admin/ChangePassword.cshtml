@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/Admin.cshtml";
}
  <link rel="stylesheet" href="@Url.Content("~/Site-Admin/css/account.css")" type="text/css" />
@using (Html.BeginForm("ChangePassword", "Admin", FormMethod.Post))
{
 <div class="span8">
                <div class="editprofileform" style="margin-left: 100px; margin-top: 20px">

                    <div class="widgetbox login-information">
                        <h5 class="widgettitle" style="background:#37465a">Đổi mật khẩu</h5>
                        <div class="widgetcontent v" style="border-color:#37465a">
                            <label>
                                Mật khẩu cũ:
                            </label>
                            <span class="field">
                                <input type="password" name="mkc" placeholder="Nhập mật khẩu cũ!"/>
                            </span>
                            <p>
                            <label>
                                Mật khẩu mới:
                            </label>
                            <span class="field">
                                <input type="password" name="mkm" placeholder="Nhập mật khẩu mới!"/>
                            </span>
                            <p>
                                <label>Nhập lại mật khẩu: </label>
                                <span class="field">
                                   <input type="password" name="mkxn" placeholder="Nhập mật khẩu xác nhận!"/>
                                     <span style="color:red">@Html.ValidationSummary(true)</span>
                                </span>
                            </p>
                           </div>
                    </div>
                    
                    <table style="width: 100%; margin-bottom: 8px">
                        <tr>
                            <td style="width: 311px; text-align: right">
                                <input type="submit" name="Luu" value="Lưu Thông Tin" class="btn" />
                                &nbsp;&nbsp;
                            </td>
                            <td>
                                <input type="submit" name="bntHuy" value="Hủy" class="btn" />
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
}
@Html.Partial("LoadCss")
