@model MVC_QuanLyTHP.Models.v_v_dm_NhanVien
@using DatabaseTHP;
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using MVC_QuanLyTHP.Models;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<hr />
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                    @Utility.GetTitleFrom(API.dm_NhanVien)
                </a>
            </h1>
        </div>


        <div id="collapseOne" class="panel-collapse collapse in">
            <div class="form-group">
                <div class="col-sm-2" style="padding-bottom: 5px;">
                    @if (ViewBag.PermissionCreate)
                    {
                        if (Utility.IntWidth == 1)
                        {
                            <button class="btn btn-success" onclick="myFunctionCreate('@{@API.dm_NhanVien;}')"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</button>
                        }
                        else
                        {
                            <a class="btn btn-success" href="@Url.Action("Create", @API.dm_NhanVien)"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</a>
                        }
                    }
                </div>
                <div class="col-sm-2" style="padding-bottom: 5px;">
                    <select class="form-control chosen-select" onchange="show('@{@API.dm_NhanVien;}')" id="Show" name="Show">
                        @for (int show = 0; show < Utility.arrShow.Length; show++)
                        {
                            if (Utility.GetPageSize() == @Utility.arrShow[show])
                            {
                                <option value="@Utility.arrShow[show]" selected>@Utility.arrShow[show]</option>
                            }
                            else
                            {
                                <option value="@Utility.arrShow[show]">@Utility.arrShow[show]</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-sm-2" style="padding-bottom: 5px;">
                    <select class="form-control chosen-select" id="ShowSearchValue" name="ShowSearchValue">
                        @for (int show = 0; show < Utility.listSearch.Count; show++)
                        {
                            if (ViewBag.showsearchValue == Utility.listSearch[show].Item1)
                            {
                                <option value="@Utility.listSearch[show].Item1" selected>@Utility.listSearch[show].Item2</option>
                            }
                            else
                            {
                                <option value="@Utility.listSearch[show].Item1">@Utility.listSearch[show].Item2</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-sm-4">
                    @Html.TextBox("SearchString", (string)ViewBag.searchValue, htmlAttributes: new { @class = "form-control", @style = "width:80%;display:inline-block", @placeholder = Utility.TimKiem })
                    <button class="btn btn-default" onclick="funSearchItem('@{@API.dm_NhanVien;}')"><span class='glyphicon glyphicon-search'></span></button>
                </div>
            </div>



            <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                <div class="panel-body panel-body-nopadding">
                    <div class="form-horizontal form-bordered">
                        <table class="table table-bordered mb30">
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "MA")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "NAME")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "ID_CHUCVU")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "GIOITINH")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "EMAIL")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "ADDRESS")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "TEL")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "ID_NUMBER")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "DATEOFBIRTH")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "DATEJOIN")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "ID_PHONGBAN")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "UserName")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "GHICHU")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_NhanVien, "ISACTIVE")</th>

                                    <th>

                                    </th>
                                </tr>
                            </thead>
                            <tbody id="tbodytmpitem">
                                @foreach (var item in Model.IPagedList)
                                {
                                    string DATEOFBIRTH = item.DATEOFBIRTH != null ? item.DATEOFBIRTH.Value.ToString("dd/MM/yyyy") : "";
                                    string DATEJOIN = item.DATEJOIN != null ? item.DATEJOIN.Value.ToString("dd/MM/yyyy") : "";
                                    <tr id="@item.ID">
                                        <td style="white-space: nowrap; " id="MA"> @Html.DisplayFor(modelItem => item.MA)</td>
                                        <td style="white-space: nowrap; " id="NAME"> @Html.DisplayFor(modelItem => item.NAME)</td>
                                        <td style="white-space: nowrap; " id="NAME_CHUCVU"> @Html.DisplayFor(modelItem => item.NAME_CHUCVU)</td>
                                        <td style="white-space: nowrap; " id="NAME_GIOITINH"> @Html.DisplayFor(modelItem => item.NAME_GIOITINH)</td>
                                        <td style="white-space: nowrap; " id="EMAIL"> @Html.DisplayFor(modelItem => item.EMAIL)</td>
                                        <td style="white-space: nowrap; " id="ADDRESS"> @Html.DisplayFor(modelItem => item.ADDRESS)</td>
                                        <td style="white-space: nowrap; " id="TEL"> @Html.DisplayFor(modelItem => item.TEL)</td>
                                        <td style="white-space: nowrap; " id="ID_NUMBER"> @Html.DisplayFor(modelItem => item.ID_NUMBER)</td>
                                        <td style="white-space: nowrap; " id="DATEOFBIRTH"> @DATEOFBIRTH </td>
                                        <td style="white-space: nowrap; " id="DATEJOIN"> @DATEJOIN</td>
                                        <td style="white-space: nowrap; " id="NAME_PHONGBAN"> @Html.DisplayFor(modelItem => item.NAME_PHONGBAN)</td>
                                        <td style="white-space: nowrap; " id="UserName"> @Html.DisplayFor(modelItem => item.UserName)</td>
                                        <td style="white-space: nowrap; " id="GHICHU"> @Html.DisplayFor(modelItem => item.GHICHU)</td>
                                        <td style="white-space: nowrap; " id="ISACTIVE"> @Html.DisplayFor(modelItem => item.ISACTIVE)</td>

                                        <td style="white-space: nowrap; " class="fix">
                                            @if (ViewBag.PermissionEdit)
                                            {
                                                if (Utility.IntWidth == 1)
                                                {
                                                    <a class="label label-primary" onclick="myFunctionEdit('@{@API.dm_NhanVien;}','@item.ID')" href="#"><i class="fa fa-edit" style="margin-right:5px"></i>@Utility.Sua</a>
                                                }
                                                else
                                                {
                                                    @Html.ActionLink(Utility.Sua, "Edit", new { id = item.ID }, htmlAttributes: new { @class = "label label-primary" });
                                                }
                                            }
                                            @if (ViewBag.PermissionDelete)
                                            {
                                                if (Utility.IntWidth == 1)
                                                {
                                                    <a class="label label-danger" onclick="myFunctionPopup('@{@API.dm_NhanVien;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px" ></i>@Utility.Xoa</a>
                                                }
                                                else
                                                {
                                                    <a class="label label-danger" onclick="myFunction('@{@API.dm_NhanVien;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px" ></i>@Utility.Xoa</a>
                                                }

                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div><!-- table-responsive -->
            </div>

            <div class="panel-footer">
                @Html.PagedListPager((PagedList.IPagedList<v_dm_NhanVien>)Model.IPagedList, page => Url.Action("Index", new { Page = page, ShowSearchValue = ViewBag.showsearchValue, SearchString = ViewBag.searchValue }))
            </div>
        </div>
    </div>
</div>
@if (Utility.IntWidth == 1)
{
    if (ViewBag.PermissionCreate)
    {
        <button id="myBtnAdd" style="display:none"></button>
        <div id="myModalAdd" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Create", @API.dm_NhanVien, new { type = 1 });}
            </div>
        </div>
    }
    if (ViewBag.PermissionEdit)
    {
        <button id="myBtnEdit" style="display:none"></button>
        <div id="myModalEdit" class="modal">
            <div class="panel panel-default" @Html.Raw(Utility.StypeWidth_Level1)>
                <!-- The Modal -->
                @{Html.RenderAction("Edit", @API.dm_NhanVien, new { type = 1 });}
            </div>
        </div>
    }
}