@model MVC_QuanLyTHP.Models.User_InsertModel
@{
    ViewBag.Title = "Member_profile";
    Layout = "~/Views/Shared/Admin.cshtml";
}
@using (Html.BeginForm("Member_profile", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{ 
 <div class="contentpanel">    
<div class="panel panel-default">
      @foreach (var item in Model.Nguoidung){
 <div class="panel-heading">
          <div class="panel-btns">
            <a href="#" class="panel-close">&times;</a>
            <a href="#" class="minimize">&minus;</a>
          </div>
          <h4 class="panel-title" style="text-align:center;">Thông tin thành viên</h4>
        </div>
        <div class="panel-body panel-body-nopadding"><div class="form-horizontal form-bordered">
             <div class="form-group">
              <label class="col-sm-3 control-label"></label>
              <div class="col-sm-6">
                   <img alt="" src="~/Images_sp/@item.Hinh" id="myimage" style="width: 150px"/> <br />
                <div class="fileupload fileupload-new" data-provides="fileupload">
                  <div class="input-append">
                    <div class="uneditable-input">
                      <i class="glyphicon glyphicon-file fileupload-exists"></i>
                      <span class="fileupload-preview"></span>
                    </div>
                    <span class="btn btn-default btn-file">
                      <span class="fileupload-new">Select file</span>
                      <span class="fileupload-exists">Change</span>
                      <input type="file" name="MaHinh" id="MaHinh"  onchange="onFileSelected(event)"/>
                    </span>
                    <a href="#" class="btn btn-default fileupload-exists" data-dismiss="fileupload">Remove</a>
                  </div>
                </div>
              </div>
            </div>
            <div class="form-group">
              <label class="col-sm-3 control-label">Tên khách hàng</label>
              <div class="col-sm-6">
                <input type="text" class="form-control" value="@item.TenKH" name="ten" />
                  <span style="color:red"> @Html.ValidationMessageFor(m => m.ten)</span>
              </div>
            </div>
            
            <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Tên đăng nhập</label>
				  <div class="col-sm-6">
					<input type="text" class="form-control" value="@item.TenDN" name="user"/>
                       <span style="color:red">@Html.ValidationMessageFor(m => m.user)</span>
				  </div>
				</div>
            <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Mât khẩu</label>
				  <div class="col-sm-6">
					<input type="password" class="form-control" value="@item.MatKhau" name="pass"/>
                       <span style="color:red">@Html.ValidationMessageFor(m => m.pass)</span>
				  </div>
			</div>
             <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Email</label>
				  <div class="col-sm-6">
					<input type="text" class="form-control" value="@item.EMAIL" name="email"/>
                      <span style="color:red">@Html.ValidationMessageFor(m => m.email)</span>
				  </div>
				</div>
            
             <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Chứng minh nhân dân</label>
				  <div class="col-sm-6">
					<input type="text" class="form-control" value="@item.CMND" name="CMND"/>
                       <span style="color:red">@Html.ValidationMessageFor(m => m.CMND)</span>
				  </div>
				</div>
            
            <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Số điện thoại</label>
				  <div class="col-sm-6">
					<input type="text" class="form-control" value="@item.SDT" name="sdt"/>
                      <span style="color:red">@Html.ValidationMessageFor(m => m.sdt)</span>
				  </div>
				</div>
            
           <div class="form-group">
				  <label class="col-sm-3 control-label" for="disabledinput">Ngày sinh</label>
				  <div class="col-sm-6">
					<input type="date" class="form-control" value="@DateTime.Parse(@item.NgaySinh.ToString()).ToString("yyyy-MM-dd")" name="ngaysinh"/>
                       <span style="color:red">@Html.ValidationMessageFor(m => m.ngaysinh)</span>
				  </div>
				</div>
            
           <div class="form-group">
              <label class="col-sm-3 control-label">Giới tính</label>
              <div class="col-sm-5">
                <select class="form-control chosen-select" data-placeholder="Giới tính..." name="gioitinh">
                        @if (@item.GioiTinh.ToString() == "Nam") { 
                            <option value="Nam" selected>Nam</option>
                            <option value="Nữ">Nữ</option>
                        }else{
                             <option value="Nam">Nam</option>
                            <option value="Nữ" selected>Nữ</option>
                        }
                </select>
              </div>
            </div>
            
           <div class="form-group">
              <label class="col-sm-3 control-label">Quyền</label>
              <div class="col-sm-5">
                <select class="form-control chosen-select" data-placeholder="Quyền..." name="MaQ">
                    @foreach (var item1 in Model.Quyen){
                        if (@item.MaQ.ToString() == @item1.MaQ.ToString()) { 
                            <option value="@item1.MaQ" selected>@item1.TenQuyen</option>
                        }else{
                     <option value="@item1.MaQ">@item1.TenQuyen</option>}
                    }
                </select>
              </div>
            </div>
          
          
        </div><!-- panel-body -->
        
        <div class="panel-footer">
			 <div class="row">
				<div class="col-sm-6 col-sm-offset-3">
				  <button class="btn btn-primary">Cập nhật</button>&nbsp;
				  <button class="btn btn-default">Cancel</button>
				</div>
			 </div>
		  </div><!-- panel-footer -->
      }
      </div><!-- panel -->
      </div>
}
<script>
    function onFileSelected(event) {
        var selectedFile = event.target.files[0];
        var reader = new FileReader();

        var imgtag = document.getElementById("myimage");
        imgtag.title = selectedFile.name;

        reader.onload = function (event) {
            imgtag.src = event.target.result;
        };

        reader.readAsDataURL(selectedFile);
    }
</script>

@Html.Partial("LoadCss")