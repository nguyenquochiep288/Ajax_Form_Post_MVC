    }

    .qrcode-text-btn {
        display: inline-block;
        background: url(images/1499401426qr_icon.svg) 50% 50% no-repeat;
        height: 1em;
        width: 2.7em;
        margin-left: -2.7em;
        cursor: pointer;
    }

        .qrcode-text-btn > input[type=file] {
            position: absolute;
            overflow: hidden;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

    #QRTextbox {
        display: block;
        margin: 0 auto;
        width: 100%;
        text-align: center;
    }
</style>
