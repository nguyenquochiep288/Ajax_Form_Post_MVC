<style>
    main {
        display: flex;
        justify-content: center;
        align-items: center;
    }

    #reader {
        width: 600px;
    }

    #result {
        text-align: center;
        font-size: 1.5rem;
    }
</style>
<div id="result">
</div>
<main>
    <div id="reader" onload="myFunction()"></div>
</main>
<script>
    const scanner = new Html5QrcodeScanner('reader', {
        qrbox: {
            width: 250,
            height: 250,
        },
        fps: 20,
    });
    scanner.render(success, error);
    function success(result) {
        var string = result.replace(' TRIAL', '');
        string = string.replace('TRIAL', '');
        document.getElementById('result').innerHTML = `
        <h2>Success!</h2>
        <p><a href="${string}">${string}"</a></p>
        <p><a class="btn btn-primary" onclick='myFunOpenQR()'>@Utility.QuayLai</a></p>`;
        //scanner.clear();
        //document.getElementById('reader').remove();
        document.getElementById('reader').style.visibility = 'hidden';
        document.getElementById('result').style.visibility = 'visible';
    }
    function error(err) {
        console.error(err);
    }

    window.addEventListener("load", (event) => {
        try
        {
            document.getElementById('html5-qrcode-button-camera-permission').style.fontSize = "14pt";
            document.getElementById('html5-qrcode-button-camera-permission').innerHTML = "Quét mã(Yêu cầu quyền sử dụng máy ảnh)";
            document.getElementById('html5-qrcode-anchor-scan-type-change').style.visibility = "hidden";
            document.querySelectorAll('#reader img')[0].style.visibility = "hidden";
        }
        catch
        {
        }
    });

    function myFunOpenQR()
    {
        document.getElementById('result').innerHTML = "";
        document.getElementById('reader').style.visibility = 'visible';
        document.getElementById('result').style.visibility = 'hidden';
    }
</script>

