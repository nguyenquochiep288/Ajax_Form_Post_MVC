@model MVC_QuanLyTHP.Models.v_v_AspNetUsers
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/Admin.cshtml";
    var avatar = string.IsNullOrWhiteSpace(Model.URL_IMAGE) ? Url.Content("~/Images_sp/hinh.jpg") : Url.Content(Model.URL_IMAGE);
}

<style>
    .profile-page { max-width: 1080px; margin: 26px auto; padding: 0 18px 36px; color: #344054; }
    .profile-heading { margin: 0 0 20px; font-size: 24px; font-weight: 600; color: #243447; }
    .profile-card { background: #fff; border: 1px solid #e5eaf0; border-radius: 12px; box-shadow: 0 8px 24px rgba(31, 45, 61, .07); overflow: hidden; }
    .profile-banner { padding: 24px 28px; background: linear-gradient(120deg, #f1fbf9, #f6f8fc); border-bottom: 1px solid #e8edf2; display: flex; align-items: center; gap: 18px; }
    .profile-avatar { width: 88px; height: 88px; object-fit: cover; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 2px 12px rgba(16, 24, 40, .15); }
    .profile-name { margin: 0 0 5px; font-size: 20px; font-weight: 600; color: #243447; }
    .profile-username { color: #748196; margin: 0; }
    .profile-form { padding: 26px 30px 30px; }
    .profile-form .form-group { margin-bottom: 20px; }
    .profile-form label { color: #526173; font-weight: 600; }
    .profile-form .form-control { height: 42px; border-radius: 7px; box-shadow: none; border-color: #d8e0e8; }
    .profile-form .form-control:focus { border-color: #19aa9b; box-shadow: 0 0 0 3px rgba(25, 170, 155, .12); }
    .profile-image-help { color: #8793a2; font-size: 12px; margin-top: 7px; }
    .profile-actions { border-top: 1px solid #edf0f4; margin-top: 8px; padding-top: 22px; }
    .profile-save { border: 0; border-radius: 7px; padding: 10px 22px; background: #16a996; color: #fff; font-weight: 600; }
    .profile-save:hover, .profile-save:focus { background: #108f81; color: #fff; }
    .profile-cancel { margin-left: 8px; border-radius: 7px; padding: 9px 18px; }
    @@media (max-width: 767px) {
        .profile-page { margin: 15px auto; padding: 0 10px 24px; }
        .profile-banner, .profile-form { padding: 20px; }
        .profile-form .control-label { text-align: left; margin-bottom: 6px; }
    }
</style>

<div class="profile-page">
    <h1 class="profile-heading">Thông tin tài khoản</h1>
    <div class="profile-card">
        <div class="profile-banner">
            <img id="profileAvatar" class="profile-avatar" src="@avatar" alt="Ảnh đại diện" />
            <div>
                <h2 class="profile-name">@(string.IsNullOrWhiteSpace(Model.NAME) ? Model.FullName : Model.NAME)</h2>
                <p class="profile-username">@@@(Model.UserName ?? "")</p>
            </div>
        </div>

        @using (Html.BeginForm("My_profile", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "profile-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
            if (TempData["ProfileSuccess"] != null)
            {
                <div class="alert alert-success">@TempData["ProfileSuccess"]</div>
            }

            <div class="form-group">
                <label class="col-sm-3 control-label" for="MaHinh">Ảnh đại diện</label>
                <div class="col-sm-8">
                    <input class="form-control" type="file" name="MaHinh" id="MaHinh" accept="image/jpeg,image/png,image/gif,image/webp" />
                    @Html.ValidationMessage("MaHinh", new { @class = "text-danger" })
                    <p class="profile-image-help">JPG, PNG, GIF hoặc WEBP, tối đa 5 MB.</p>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" for="fullName">Họ và tên</label>
                <div class="col-sm-8">
                    <input class="form-control" type="text" id="fullName" name="fullName" maxlength="256" required value="@(Model.NAME ?? Model.FullName)" />
                    @Html.ValidationMessage("fullName", new { @class = "text-danger" })
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" for="userName">Tên đăng nhập</label>
                <div class="col-sm-8">
                    <input class="form-control" type="text" id="userName" name="userName" maxlength="256" required value="@Model.UserName" autocomplete="username" />
                    @Html.ValidationMessage("userName", new { @class = "text-danger" })
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" for="email">Email</label>
                <div class="col-sm-8">
                    <input class="form-control" type="email" id="email" name="email" maxlength="256" value="@Model.Email" autocomplete="email" />
                    @Html.ValidationMessage("Email", new { @class = "text-danger" })
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="form-group">
                <label class="col-sm-3 control-label" for="phoneNumber">Số điện thoại</label>
                <div class="col-sm-8">
                    <input class="form-control" type="tel" id="phoneNumber" name="phoneNumber" maxlength="50" value="@Model.PhoneNumber" autocomplete="tel" />
                    @Html.ValidationMessage("PhoneNumber", new { @class = "text-danger" })
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="profile-actions col-sm-offset-3 col-sm-8">
                <button type="submit" class="btn profile-save"><i class="fa fa-check"></i> Lưu thay đổi</button>
                <a class="btn btn-default profile-cancel" href="@Url.Action("Index", "Admin")">Quay lại</a>
            </div>
            <div class="clearfix"></div>
        }
    </div>
</div>

<script>
    (function () {
        var input = document.getElementById('MaHinh');
        var avatar = document.getElementById('profileAvatar');
        if (!input || !avatar) return;
        input.addEventListener('change', function () {
            var file = input.files && input.files[0];
            if (!file || !/^image\/(jpeg|png|gif|webp)$/.test(file.type)) return;
            var reader = new FileReader();
            reader.onload = function (event) { avatar.src = event.target.result; };
            reader.readAsDataURL(file);
        });
    }());
</script>
