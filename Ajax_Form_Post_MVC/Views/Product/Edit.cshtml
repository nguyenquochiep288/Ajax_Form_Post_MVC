}
<script type="text/javascript">
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters
        $("input[type='hidden'][name='ISACTIVE']").remove();
        $("input[type='hidden'][name='STATUS_HIENTHI']").remove();
        $("input[type='hidden'][name='STATUS_QD']").remove();
        $("input[type='hidden'][name='BAOGOMTHUESUAT']").remove();
        $("input[type='hidden'][name='ISKHONGHIENTHITONKHO']").remove();
    });
</script>
