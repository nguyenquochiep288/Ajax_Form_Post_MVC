@model MVC_QuanLyTHP.Models.v_v_dm_TaiKhoan_Misa
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("EditPopup", API.dm_TaiKhoan_Misa, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessEdit" }))
    {
        @Html.AntiForgeryToken()
        <div class="panel-heading" style="padding-top:15px;padding-right: 15px;">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalEdit")'>&times;</a>
            </div>
            
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.dm_TaiKhoan_Misa)</label></h1>
            <div class="panel-body" style="padding:5px">

            </div>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.ID)

        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "MASOTHUE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.MASOTHUE, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.MASOTHUE, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "USERNAME"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.USERNAME, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.USERNAME, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "PASSWORD"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.PasswordFor(model => model.PASSWORD, new { @class = "form-control pword" })
                        @Html.ValidationMessageFor(model => model.PASSWORD, "", new { @class = "text-danger" })
                    </div>
                    <input type="checkbox" onclick="myFunctionShowPassword()"> <label>Hiện mật khẩu</label>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "LINK"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.LINK, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.LINK, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_KhachHang, "ACCESSTOKEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextAreaFor(model => model.ACCESSTOKEN, new { @class = "form-control", @rows = "3" })
                        @Html.ValidationMessageFor(model => model.ACCESSTOKEN, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "LINK_TRACUU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.LINK_TRACUU, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.LINK_TRACUU, "", new { @class = "text-danger" })
                    </div>
                </div>*@
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "ISACTIVE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.ISACTIVE, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ISACTIVE, "", new { @class = "text-danger" })
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalEdit")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                            @Utility.GetTitleFrom(API.dm_TaiKhoan_Misa)
                        </a>
                    </h1>
                </div>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.ID)

                <div id="collapseOne" class="panel-collapse collapse in">
                    <div class="form-horizontal form-bordered">
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "MASOTHUE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.MASOTHUE, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.MASOTHUE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "USERNAME"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.USERNAME, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.USERNAME, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "PASSWORD"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.PasswordFor(model => model.PASSWORD, new { @class = "form-control pword" })
                                @Html.ValidationMessageFor(model => model.PASSWORD, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "LINK"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.EditorFor(model => model.LINK, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.LINK, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_KhachHang, "ACCESSTOKEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.TextAreaFor(model => model.ACCESSTOKEN, new { @class = "form-control", @rows = "3" })
                                @Html.ValidationMessageFor(model => model.ACCESSTOKEN, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.dm_TaiKhoan_Misa, "ISACTIVE"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-5">
                                @Html.CheckBoxFor(model => model.ISACTIVE, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(model => model.ISACTIVE, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-2">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                            @if (Request.UrlReferrer != null)
                            {
                                <a href="@Request.UrlReferrer.ToString()" class="btn btn-danger">@Utility.QuayLai</a>
                            }
                            else
                            {

                                @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
<script type="text/javascript">
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters
        $("input[type='hidden'][name='ISACTIVE']").remove();
    });
</script>
