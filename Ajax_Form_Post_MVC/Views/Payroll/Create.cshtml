@model MVC_QuanLyTHP.Models.v_v_nv_BangLuong
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
<script src="@Url.Content("~/Scripts/Payroll.js")"></script>
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("CreatePopup", API.nv_BangLuong, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessCreate" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("@ViewBag.myModalAdd")'>&times;</a>
            </div>
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.nv_BangLuong)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.LOC_ID)
        @Html.HiddenFor(model => model.ID)
        @Html.HiddenFor(model => model.SOPHIEU)
        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "MAPHIEU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-2">
                        @Html.EditorFor(model => model.MAPHIEU, new { htmlAttributes = new { @class = "form-control", @readonly = "readonly" } })
                        @Html.ValidationMessageFor(model => model.MAPHIEU, "", new { @class = "text-danger" })
                    </div>
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "NGAYLAP"), htmlAttributes: new { @class = "col-sm-1 control-label" })
                    <div class="col-sm-2">
                        @Html.TextBoxFor(model => model.NGAYLAP, (Model.NGAYLAP).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date", @onchange = "CallChangePayroll(this.value,'NGAYLAP')" })
                        @Html.ValidationMessageFor(model => model.NGAYLAP, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "ID_THANGLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_THANGLUONG, new SelectList(Model.lstdm_ThangLuong, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_THANGLUONG) ? "" : Utility.GetTitleChon(API.dm_ThangLuong), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_ThangLuong", @onchange = "CallChangePayroll(this.value,'dm_ThangLuong')" })
                        @Html.ValidationMessageFor(model => model.ID_THANGLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "ID_NHANVIEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_NHANVIEN, new SelectList(Model.lstdm_NhanVien, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHANVIEN) ? "" : Utility.GetTitleChon(API.dm_NhanVien), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_NhanVien", @onchange = "CallChangePayroll(this.value,'dm_NhanVien')" })
                        @Html.ValidationMessageFor(model => model.ID_NHANVIEN, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "SONGAYCONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SONGAYCONG, new { htmlAttributes = new { @class = "form-control mask", @type = "number", @step = "0.01" } })
                        @Html.ValidationMessageFor(model => model.SONGAYCONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "SONGAYLAMVIEC"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SONGAYLAMVIEC, new { htmlAttributes = new { @class = "form-control mask", @type = "number", @step = "0.01" } })
                        @Html.ValidationMessageFor(model => model.SONGAYLAMVIEC, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "SONGAYNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SONGAYNGHIPHEP, new { htmlAttributes = new { @class = "form-control mask", @type = "number", @step = "0.1" } })
                        @Html.ValidationMessageFor(model => model.SONGAYNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "SONGAYNGHIKHONGPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SONGAYNGHIKHONGPHEP, new { htmlAttributes = new { @class = "form-control mask", @type = "number", @step = "0.1" } })
                        @Html.ValidationMessageFor(model => model.SONGAYNGHIKHONGPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "MUCLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.MUCLUONG, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.MUCLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "TIENDAUKY"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.TIENDAUKY, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.TIENDAUKY, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "TIENLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.TIENLUONG, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.TIENLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "TIENGIAM"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.TIENGIAM, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.TIENGIAM, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "TIENTHUCNHAN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.TIENTHUCNHAN, new { htmlAttributes = new { @class = "form-control mask", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.TIENTHUCNHAN, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextAreaFor(model => model.GHICHU, new { @class = "form-control", @rows = "3" })
                        @Html.ValidationMessageFor(model => model.GHICHU, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_BangLuong, "ISTINHLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.ISTINHLUONG, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ISTINHLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group" id="divReport_Add">
                    <div class="col-sm-5" style="width:100%">
                        <h5 class="subtitle">
                            Danh sách chi tiết lương:  @Html.ValidationMessageFor(model => model.lstnv_BangLuong_ChiTiet, "", new { @class = "text-danger" })
                            <a href="#" class="pull-lef" onclick="myFunctionAddPayroll('@API.nv_BangLuong')">  +Thêm chi tiết lương</a>
                            <a href="#" class="pull-right" onclick="myFunctionGetPayrollDetail('@API.nv_BangLuong','myModalAdd')">  +Lấy bảng lương  </a>
                        </h5>
                        <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                            <div class="panel-body panel-body-nopadding">
                                <div class="form-horizontal form-bordered">
                                    <table class="table table-bordered mb30">
                                        <thead>
                                            <tr>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong_ChiTiet, "ID_LOAILUONG")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong_ChiTiet, "TYPE_LUONG")</th>
                                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong_ChiTiet, "SOTIEN")</th>
                                                <th>
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyReport_Add">
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("@ViewBag.myModalAdd")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {

    }
}
