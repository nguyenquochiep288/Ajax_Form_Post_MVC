@model MVC_QuanLyTHP.Models.v_v_nv_BangLuong
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using MVC_QuanLyTHP.Models;
@using DatabaseTHP;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
<script src="@Url.Content("~/Scripts/InputOutput.js")"></script>
@Html.Partial("LoadCssDanhMuc")
<hr />
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                    @Utility.GetTitleFrom(API.nv_BangLuong)
                </a>
            </h1>
        </div>


        <div id="collapseOne" class="panel-collapse collapse in">
            <div class="form-group">
                <div class="col-sm-3" style="padding-bottom: 5px;">
                    <button id="download-excel" style="background-color: #217346;" class="btn btn-success" onclick="ExportExcel('example-table')"><i class="fa fa-file-text-o" style="margin-right:10px"></i>@Utility.XuatExcel</button>
                    @if (ViewBag.PermissionCreate)
                    {
                        if (Utility.IntWidth == 1)
                        {
                            <button class="btn btn-success" onclick="myFunctionCreate('@{@API.nv_BangLuong;}')"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</button>
                        }
                        else
                        {
                            <a class="btn btn-success" href="@Url.Action("Create", @API.nv_BangLuong)"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</a>
                        }
                    }
                </div>
            </div>
            <div class="form-group">
                <div class="col-sm-1" style="padding-bottom: 5px;">
                    <select class="form-control chosen-select" onchange="show('@{@API.nv_BangLuong;}')" id="Show" name="Show">
                        @for (int show = 0; show < Utility.arrShow.Length; show++)
                        {
                            if (Utility.GetPageSize() == @Utility.arrShow[show])
                            {
                                <option value="@Utility.arrShow[show]" selected>@Utility.arrShow[show]</option>
                            }
                            else
                            {
                                <option value="@Utility.arrShow[show]">@Utility.arrShow[show]</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-sm-2" style="padding-bottom: 5px;">
                    <input type="date" class="form-control" name="fromdate" id="fromdate" value="@ViewBag.fromdate" />
                </div>
                <div class="col-sm-2">
                    <input type="date" class="form-control" name="todate" id="todate" value="@ViewBag.todate" />
                </div>
                <div class="col-sm-4">
                    @Html.TextBox("SearchString", (string)ViewBag.searchValue, htmlAttributes: new { @class = "form-control", @style = "width:80%;display:inline-block", @placeholder = Utility.TimKiem })
                    <button class="btn btn-default" onclick="funSearchInputOutput('@{@API.nv_BangLuong;}')"><span class='glyphicon glyphicon-search'></span></button>
                </div>
            </div>

            <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                <div class="panel-body panel-body-nopadding">
                    <table class="table table-bordered mb30" id="example-table">
                        <thead>
                            <tr>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "NGAYLAP")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "ID_THANGLUONG")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "ID_NHANVIEN")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "MUCLUONG")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "SONGAYCONG")</th>

                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "SONGAYLAMVIEC")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "SONGAYNGHIPHEP")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "SONGAYNGHIKHONGPHEP")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "TIENDAUKY")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "TIENLUONG")</th>
                                @*<th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "TIENLUONGKHAC")</th>*@
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "TIENGIAM")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "TIENTHUCNHAN")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "GHICHU")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_BangLuong, "ISTINHLUONG")</th>

                                <th>

                                </th>
                            </tr>
                        </thead>
                        <tbody id="tbodytmpitem">
                            @foreach (var item in Model.IPagedList)
                            {
                                string TIENLUONG = item.TIENLUONG.ToString("N0");
                                string TIENLUONGKHAC = item.TIENLUONGKHAC.ToString("N0");
                                string MUCLUONG = item.MUCLUONG.ToString("N0");
                                string TIENGIAM = item.TIENGIAM.ToString("N0");
                                string TIENTHUCNHAN = item.TIENTHUCNHAN.ToString("N0");
                                string TIENDAUKY = item.TIENDAUKY.ToString("N0");
                                string NGAYLAP = item.NGAYLAP.ToString("dd/MM/yyyy");
                                <tr id="@item.ID">
                                    <td style="white-space: nowrap; " id="NGAYLAP"> @NGAYLAP</td>
                                    <td style="white-space: nowrap; " id="NAME_THANGLUONG"> @Html.DisplayFor(modelItem => item.NAME_THANGLUONG)</td>
                                    <td style="white-space: nowrap; " id="NAME_NHANVIEN"> @Html.DisplayFor(modelItem => item.NAME_NHANVIEN)</td>
                                    <td style="white-space: nowrap; " id="MUCLUONG"> @MUCLUONG</td>
                                    <td style="white-space: nowrap; " id="SONGAYCONG"> @Html.DisplayFor(modelItem => item.SONGAYCONG)</td>

                                    <td style="white-space: nowrap; " id="SONGAYLAMVIEC"> @Html.DisplayFor(modelItem => item.SONGAYLAMVIEC)</td>
                                    <td style="white-space: nowrap; " id="SONGAYNGHIPHEP"> @Html.DisplayFor(modelItem => item.SONGAYNGHIPHEP)</td>
                                    <td style="white-space: nowrap; " id="SONGAYNGHIPHEP"> @Html.DisplayFor(modelItem => item.SONGAYNGHIKHONGPHEP)</td>
                                    <td style="white-space: nowrap; " id="TIENDAUKY"> @TIENDAUKY</td>
                                    <td style="white-space: nowrap; " id="TIENLUONG"> @TIENLUONG</td>
                                    @*<td style="white-space: nowrap; " id="TIENLUONGKHAC"> @TIENLUONGKHAC</td>*@
                                    <td style="white-space: nowrap; " id="TIENGIAM"> @TIENGIAM</td>
                                    <td style="white-space: nowrap; " id="TIENTHUCNHAN"> @TIENTHUCNHAN</td>
                                    <td style="white-space: nowrap; " id="GHICHU"> @Html.DisplayFor(modelItem => item.GHICHU)</td>
                                    <td style="white-space: nowrap; " id="ISTINHLUONG"> @Html.DisplayFor(modelItem => item.ISTINHLUONG)</td>

                                    <td style="white-space: nowrap; " class="fix">
                                        <a class="label label-default" onclick="myFunctionViewReport('@{@API.nv_BangLuong;}','@item.ID')" href="#"><i class="fa fa-print" style="margin-right:5px"></i>@Utility.In</a>
                                        @if (ViewBag.PermissionEdit)
                                        {
                                            if (Utility.IntWidth == 1)
                                            {
                                                <a class="label label-primary" onclick="myFunctionEdit('@{@API.nv_BangLuong;}','@item.ID')" href="#"><i class="fa fa-edit" style="margin-right:5px"></i>@Utility.Sua</a>
                                            }
                                            else
                                            {
                                                @Html.ActionLink(Utility.Sua, "Edit", new { id = item.ID }, htmlAttributes: new { @class = "label label-primary" });
                                            }
                                        }
                                        @if (ViewBag.PermissionDelete)
                                        {
                                            if (Utility.IntWidth == 1)
                                            {
                                                <a class="label label-danger" onclick="myFunctionPopup('@{@API.nv_BangLuong;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                            }
                                            else
                                            {
                                                <a class="label label-danger" onclick="myFunction('@{@API.nv_BangLuong;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                            }

                                        }
                                    </td>
                                </tr>
                            }
                    </table>
                </div>
            </div><!-- table-responsive -->
        </div>

        <div class="panel-footer">
            @Html.PagedListPager((PagedList.IPagedList<v_nv_BangLuong>)Model.IPagedList, page => Url.Action("Index", new { Page = page, ShowSearchValue = ViewBag.showsearchValue, SearchString = ViewBag.searchValue }))
        </div>
    </div>
</div>
@if (Utility.IntWidth == 1)
{
    <button id="myBtnAdd" style="display:none"></button>
    <div id="myModalAdd" class="modal">
        <div class="panel panel-default" style="width: 70%; margin-left: 15%;">
            <!-- The Modal -->
            @{Html.RenderAction("Create", @API.nv_BangLuong, new { type = 1 });}
        </div>
    </div>

    <button id="myBtnEdit" style="display:none"></button>
    <div id="myModalEdit" class="modal">
        <div class="panel panel-default" style="width: 70%; margin-left: 15%">
            <!-- The Modal -->
            @{Html.RenderAction("Edit", @API.nv_BangLuong, new { type = 1 });}
        </div>
    </div>
}

