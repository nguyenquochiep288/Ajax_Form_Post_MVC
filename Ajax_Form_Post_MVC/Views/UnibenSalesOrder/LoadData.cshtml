                        <div class="panel-body panel-body-nopadding">
                            <table class="table table-bordered mb30" id="example-table">
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "STT")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "ID")</th>
