                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "NAME")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "ISKHUYENMAI")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "ID_HANGHOA")</th>
                                        <th>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tbodytmpitem">
                                    @if (Model.KhachHang != null)
                                    {
                                        int STT = 1;
                                        foreach (var item in Model.HangHoa)
                                        {
                                            string idHangHoa = "lstdm_HangHoa|" + @item.ID_UNIBEN + "|" + item.ISKHUYENMAI;
                                            <tr id="@item.ID_UNIBEN">
                                                <td>@STT.ToString("N0")</td>
                                                <td style="white-space: nowrap;" id="ID_UNIBEN"> @Html.DisplayFor(modelItem => item.ID_UNIBEN)</td>
                                                <td style="white-space: nowrap;" id="MAKHACHHANG"> @Html.DisplayFor(modelItem => item.MAHANGHOA)</td>
                                                <td style="white-space: nowrap;" id="TENKHACHHANG"> @Html.DisplayFor(modelItem => item.TENHANGHOA)</td>
                                                <td style="white-space: nowrap;" id="ISKHUYENMAI"> @Html.DisplayFor(modelItem => item.ISKHUYENMAI)</td>
                                                <td style="white-space: nowrap;" id="ID_HANGHOA">
                                                    <div class="input-group mb15">
                                                        <span class="input-group-btn">
                                                            <button type="button" class="btn btn-default" onclick="myFunOpenSearch('accordion1', '@{@API.dm_HangHoa;}', '@API.Chon1','@idHangHoa', '')"><span class="glyphicon glyphicon-search"></span></button>
                                                        </span>
                                                        @Html.DropDownList("lstdm_HangHoa|" + item.ID_UNIBEN + "|" + item.ISKHUYENMAI, new SelectList(Model.HangHoa.Count < 10 ? Model.lstdm_HangHoa : Model.lstdm_HangHoa.Where(e => e.ID == item.ID_HANGHOA), "ID", "NAME", item.ID_HANGHOA), !string.IsNullOrEmpty(item.ID_HANGHOA) ? item.ID_HANGHOA : Utility.GetTitleChon(API.dm_HangHoa), htmlAttributes: new { @class = "form-control chosen-select", id = @idHangHoa })
                                                    </div>
                                                </td>
                                                <td style="white-space: nowrap; " class="fix">
                                                </td>
                                            </tr>
            STT += 1;
                                                            }
                                                        }

                            </table>
                        </div>
                    </div><!-- table-responsive -->
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-3">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}

