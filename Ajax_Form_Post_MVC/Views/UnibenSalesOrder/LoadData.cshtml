@if (Model.NhanVien != null && Model.NhanVien.Count == 0
    && Model.KhachHang != null && Model.KhachHang.Count == 0
    && Model.HangHoa != null && Model.HangHoa.Count == 0
     && Model.lstDonHang != null && Model.lstDonHang.Count > 0)
{
    using (Ajax.BeginForm("Create" + API.UnibenSalesOrder, API.UnibenSalesOrder, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnSuccessCreateTimekeeping" }))
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion3">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion3" href="#collapseOne3">
                            @Utility.GetTitleFrom(API.ct_PhieuDatHang)
                        </a>
                    </h1>
                </div>


                <div id="collapseOne3" class="panel-collapse collapse in">
                    <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                        <div class="panel-body panel-body-nopadding">
                            <table id="tree-table" class="table table-hover table-bordered">
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;">
                                            <input type="checkbox" onchange="OnchangeCheckbox(event, 'tbodytmpitem')" />
                                        </th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "MAPHIEU")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "NGAYLAP")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "TUYENXE")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "MAKHACHHANG")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "TENKHACHHANG")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "DIACHI")</th>

                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;" class="fix"> @Utility.GetColumnName(@API.UnibenSalesOrder, "THANHTIEN")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.UnibenSalesOrder, "GHICHU")</th>
                                        <th>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="tbodytmpitem">
                                    @if (Model.lstDonHang != null)
                                    {
                                        int i = 100;
                                        foreach (var item in Model.lstDonHang)
                                        {
                                            <tr data-id="@item.unibenOrder.orderCode" data-parent="0" data-level="1" id="@item.unibenOrder.orderCode" style="color: #428bca">
                                                <td style="white-space: nowrap;" id="CHON">
                                                    @if (!item.DATONTAI)
                                                    {
                                                        @Html.CheckBox("chk|" + item.unibenOrder.orderCode, htmlAttributes: new { @class = "form-control", @id = "chk|" + item.unibenOrder.orderCode })
                                                    }
                                                </td>
                                                <td data-column="name">@item.unibenOrder.orderCode</td>
                                                <td>@item.unibenOrder.orderDate.ToString("dd/MM/yyyy")</td>
                                                <td>@item.unibenOrder.routeCode - @item.unibenOrder.userName</td>
                                                <td>@item.unibenOrder.customerId - @item.unibenOrder.customerCode</td>
                                                <td>@item.unibenOrder.customerName</td>
                                                <td>@item.unibenOrder.deliveryAddress</td>
                                                <td>@item.unibenOrder.totalAmount.ToString("N0")</td>
                                                <td>@item.MAPHIEUDATHANG</td>
                                            </tr>
                                            <tr data-id="@i" data-parent="@item.unibenOrder.orderCode" data-level="2" id="@i" style="color: #428bca">
                                                <td></td>
                                                <td></td>
                                                <td>@item.DonDatHang.NGAYLAP.ToString("dd/MM/yyyy")</td>
                                                <td>@item.DonDatHang.NAME_NHANVIEN</td>
                                                <td>@item.DonDatHang.MA_KHACHHANG</td>
                                                <td>@item.DonDatHang.NAME_KHACHHANG</td>
                                                <td>@item.DonDatHang.DIACHI_KHACHHANG</td>
                                                <td>@item.DonDatHang.TONGTIEN.ToString("N0")</td>
                                                <td></td>
                                            </tr>

                                            <tr data-id="@i" data-parent="@item.unibenOrder.orderCode" data-level="2" id="@i" style="color: #428bca">
                                                <td></td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "MA")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "NAME")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_HangHoa, "ID_DVT")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuDatHang_ChiTiet, "SOLUONG")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuDatHang_ChiTiet, "DONGIA")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuDatHang_ChiTiet, "TONGTIENGIAMGIA")</td>
                                                <td style="font-weight: bold; text-align:center; white-space: nowrap;" class="fix"> @Utility.GetColumnName(@API.ct_PhieuDatHang_ChiTiet, "TONGCONG")</td>
                                                <td>
                                                </td>
                                            </tr>

                                            foreach (var it in item.DonDatHang.lstct_PhieuDatHang_ChiTiet)
                                            {
                                                <tr data-id="@i" data-parent="@item.unibenOrder.orderCode" data-level="2" id="@i">
                                                    <td></td>
                                                    <td>@it.MA</td>
                                                    <td>@it.NAME</td>
                                                    <td>@it.NAME_DVT</td>
                                                    <td>@it.SOLUONG.ToString("N0")</td>
                                                    <td>@it.DONGIA.ToString("N0")</td>
                                                    <td>@it.TONGTIENGIAMGIA.ToString("N0")</td>
                                                    <td>@it.TONGCONG.ToString("N0")</td>
                                                    <td></td>
                                                </tr>
                                            }
                                            i += 1;
                                        }
                                    }
                            </table>
                        </div>
                    </div><!-- table-responsive -->
                </div>
                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-3">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
<script src="@Url.Content("~/Content/js/javascript.js")"></script>
@if (Model.lstDonHang != null)
{
    <script type="text/javascript">
        $(function () {
        @foreach(var item in Model.lstDonHang)
        {
                // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters
                <text>
                    $("input[type='hidden'][name='chk|@item.unibenOrder.orderCode']").remove();
                    $("input[type='hidden'][name='chk|@item.unibenOrder.orderCode']").remove();
                </text>
        }
         });
    </script>
}
