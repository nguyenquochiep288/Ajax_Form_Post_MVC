<script>
    function searchCustomer(event) {
        event.preventDefault(); // ⛔ chặn submit form
        OpenLoaderCategory();
        var searchValue = $('input[name="SearchString"]').val();
        var type = $('input[name="Type"]').val();
        window.location.href = '/UnibenSalesOrder/LinkUniben?Type=' + type + '&SearchString=' + encodeURIComponent(searchValue);
    }

    function GetUniben(event) {
        event.preventDefault(); // ⛔ chặn submit form
        if (confirm("Bạn có chắc chắn muốn lấy dữ liệu Uniben không?")) {
            OpenLoaderCategory();
            var type = $('input[name="Type"]').val();
            window.location.href = '/UnibenSalesOrder/LinkUniben?Type=' + type + '&TypeGet=GetUniben';
        }
    }
</script>