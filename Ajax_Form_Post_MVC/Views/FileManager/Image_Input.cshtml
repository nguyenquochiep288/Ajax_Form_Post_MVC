<script>
    jQuery(document).ready(function () {
        //Replaces data-rel attribute to rel.
        //We use data-rel because of w3c validation issue
        jQuery('a[data-rel]').each(function () {
            jQuery(this).attr('rel', jQuery(this).data('rel'));
        });

        jQuery("a[rel^='prettyPhoto']").prettyPhoto();

    });

    function openQRCamera(node) {
        var reader = new FileReader();
        reader.onloadend = function (e) {
            //alert(node.files[0].name);
            //alert(node.files[0].lastModifiedDate);
            var date = new Date(node.files[0].lastModified);
            var dataUrl = reader.result;
            document.getElementById("txtNameFile").innerHTML = node.files[0].name;
            document.getElementById("txthrefUrl").href = e.target.result;
            document.getElementById("txtsrcUrl").src = e.target.result;;
            document.getElementById("txtCreateFile").innerHTML = format_time(date);
            // Paint image, as a proof of concept
            //var img = document.createElement('img');
            //img.src = dataUrl;
            //document.body.appendChild(img);
            var elem = document.getElementById("NGAYTAO");
            elem.value = date.toISOString().slice(0, 16);
            //elem = document.getElementById("URL_IMAGE");
            //elem.value = dataUrl;

            var imgtagNV = document.getElementById("idFilemanagerAdd");
            imgtagNV.style.visibility = 'visible';
            imgtagNV.style.display = 'block';
        };
        reader.readAsDataURL(node.files[0]);
    }

    function format_time(t) {
        try {
            var Day = t.getDay();
            var Date = t.getDate();
            var Month = t.getMonth();
            var Year = getFullYear(t);
            var Hour = t.getHours();
            var Minutes = t.getMinutes();
            var Seconds = t.getSeconds();
            var timeString = "";
            timeString += addZero(Date);
            timeString += "/";
            timeString += addZero(Month + 1);
            timeString += "/";
            timeString += Year;
            timeString += " ";
            timeString += addZero(Hour);
            timeString += ":";
            timeString += addZero(Minutes);
            timeString += ":";
            timeString += addZero(Seconds);
            return timeString;
        } catch (ex) {
            alert(ex.Message);
            alert(ex);
        }
    }

    function addZero(i) {
        if (i < 10) { i = "0" + i }
        return i;
    }
    function getFullYear(d) {
        var y = d.getYear();
        if (y < 1000) {
            y += 1900
        };
        return y;
    }
</script>
