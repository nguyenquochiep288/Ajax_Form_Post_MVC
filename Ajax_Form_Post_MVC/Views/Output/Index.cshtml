@model MVC_QuanLyTHP.Models.v_v_ct_PhieuXuat
@using DatabaseTHP;
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<script src="@Url.Content("~/Scripts/Deposit_Temp.js"+Utility.VersionJs)"></script>
<script src="@Url.Content("~/Scripts/Invoiced.js"+Utility.VersionJs)"></script>
<script src="@Url.Content("~/Scripts/InputOutput.js"+Utility.VersionJs)"></script>
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                    @Utility.GetTitleFrom(API.ct_PhieuXuat)
                </a>
            </h1>
        </div>


        <div id="collapseOne" class="panel-collapse collapse in">
            <div class="form-group">
                @if (ViewBag.PermissionCreate)
                {
                    int TYPE = 0;
                    <div class="col-sm-3" style="padding-bottom: 5px;">
                        <button id="download-excel" style="background-color: #217346; margin-bottom: 10px;" class="btn btn-success" onclick="ExportExcel('example-table')" style="margin-bottom:10px"><i class="fa fa-file-text-o" style="margin-right:10px"></i>@Utility.XuatExcel</button>
                        <div class="btn-group mr5">
                            <button type="button" class="btn btn-success dropdown-toggle" data-toggle="dropdown">
                                <i class="fa fa-pencil-square-o" style="margin-right:5px"></i>  @Utility.Them <span class="caret"></span>
                            </button>
                            <ul class="dropdown-menu" role="menu">
                                @foreach (var itm in Model.lstdm_LoaiPhieuXuat)
                                {
                                    if (TYPE != 0 && TYPE != itm.TYPE)
                                    {
                                        <li class="divider"></li>
                                    }
                                    <li><a href="#" onclick="myFunctionCreateInputOutput('@{@API.ct_PhieuXuat;}', '@itm.ID')">@itm.NAME</a></li>
                                    TYPE = itm.TYPE;
                                }
                            </ul>
                        </div><!-- btn-group -->
                    </div>
                }

                <div class="col-sm-2" style="padding-bottom: 5px;">
                    <select class="form-control chosen-select" onchange="show('@API.ct_PhieuXuat')" id="Show" name="Show">
                        @for (int show = 0; show < Utility.arrShow.Length; show++)
                        {
                            if (Utility.GetPageSize() == @Utility.arrShow[show])
                            {
                                <option value="@Utility.arrShow[show]" selected>@Utility.arrShow[show]</option>
                            }
                            else
                            {
                                <option value="@Utility.arrShow[show]">@Utility.arrShow[show]</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-sm-2">
                    <select class="form-control chosen-select" id="id_depot" name="id_depot">
                        @foreach (var itm in Model.lstdm_Kho)
                        {
                            if (ViewBag.ID_KHO_DF == itm.ID)
                            {
                                <option value="@itm.ID" selected>@itm.NAME</option>
                            }
                            else
                            {
                                <option value="@itm.ID">@itm.NAME</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <div class="col-sm-2" style="padding-bottom: 5px;">
                    <input type="date" class="form-control" name="fromdate" id="fromdate" value="@ViewBag.fromdate" />

                </div>
                <div class="col-sm-2">
                    <input type="date" class="form-control" name="todate" id="todate" value="@ViewBag.todate" />
                </div>
                <div class="col-sm-4">
                    @Html.TextBox("SearchString", (string)ViewBag.searchValue, htmlAttributes: new { @class = "form-control", @style = "width:80%;display:inline-block", @placeholder = Utility.TimKiem })
                    <button class="btn btn-default" onclick="funSearchInputOutput('@{@API.ct_PhieuXuat;}')"><span class='glyphicon glyphicon-search'></span></button>
                </div>
            </div>

            @*<div class="form-group">
                    <div class="col-sm-2" style="padding-bottom: 5px;">
                        <select class="form-control chosen-select" id="ShowSearchValue" name="ShowSearchValue">
                            @for (int show = 0; show < Utility.listSearch.Count; show++)
                            {
                                if (ViewBag.showsearchValue == Utility.listSearch[show].Item1)
                                {
                                    <option value="@Utility.listSearch[show].Item1" selected>@Utility.listSearch[show].Item2</option>
                                }
                                else
                                {
                                    <option value="@Utility.listSearch[show].Item1">@Utility.listSearch[show].Item2</option>
                                }
                            }
                        </select>
                    </div>


                </div>*@



            <div class="tablescroll" style="overflow-x:auto; Overflow-y:scroll; height: auto;">
                <div class="panel-body panel-body-nopadding">
                    <table class="table table-bordered mb30" id="example-table">
                        <thead>
                            <tr>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;">
                                    @if (ViewBag.PermissionCreateInvoiced)
                                    {
                                        <input type="checkbox" onchange="OnchangeCheckbox(event, 'tbodytmpitem')" />
                                    }
                                </th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ID_LOAIPHIEUXUAT")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ID_KHO")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "MAPHIEU")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "NGAYLAP")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ID_KHACHHANG")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ID_NHANVIEN")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "TONGTIENGIAMGIA")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "TONGTHANHTIEN")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "TONGTIENVAT")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "TONGTIEN")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "GHICHU")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ISPHIEUDIEUHANG")</th>
                                @*<th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ISKHUYENMAI")</th>*@
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "CHUNGTUKEMTHEO")</th>
                                <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.ct_PhieuXuat, "ID_NGUOITAO")</th>
                                <th>
                                </th>
                            </tr>
                        </thead>
                        <tbody id="tbodytmpitem">
                            @if (Model.IPagedList != null)
                            {
                                foreach (var item in Model.IPagedList)
                                {
                                    <tr id="@item.ID">
                                        @if (ViewBag.PermissionCreateInvoiced && string.IsNullOrEmpty(item.ID_HOADON))
                                        {
                                            <td style="white-space: nowrap;" id="CHON"> @Html.CheckBoxFor(modelItem => item.CHON, htmlAttributes: new { @class = "form-control", @id = item.ID })</td>
                                        }
                                        else
                                        {
                                            <td></td>
                                        }
                                        <td style="white-space: nowrap; " id="NAME_LOAIPHIEUXUAT"> @Html.DisplayFor(modelItem => item.NAME_LOAIPHIEUXUAT)</td>
                                        <td style="white-space: nowrap;" id="NAME_KHO"> @Html.DisplayFor(modelItem => item.NAME_KHO)</td>
                                        <td style="white-space: nowrap;" id="MAPHIEU"> @Html.DisplayFor(modelItem => item.MAPHIEU)</td>
                                        <td style="white-space: nowrap;" id="NGAYLAP"> @item.NGAYLAP.ToString("dd/MM/yy HH:mm")</td>
                                        <td style="white-space: nowrap;" id="NAME_KHACHHANG"> @Html.DisplayFor(model => item.NAME_KHACHHANG_NCC)</td>
                                        <td style="white-space: nowrap;" id="NAME_NHANVIEN"> @Html.DisplayFor(modelItem => item.NAME_NHANVIEN)</td>
                                        <td style="white-space: nowrap;" id="TONGTIENGIAMGIA"> @item.TONGTIENGIAMGIA.ToString("N0")</td>
                                        <td style="white-space: nowrap;" id="TONGTHANHTIEN"> @item.TONGTHANHTIEN.ToString("N0")</td>
                                        <td style="white-space: nowrap;" id="TONGTIENVAT"> @item.TONGTIENVAT.ToString("N0")</td>
                                        <td style="white-space: nowrap;" id="TONGTIEN"> @item.TONGTIEN.ToString("N0")</td>
                                        <td style="white-space: nowrap;" id="GHICHU"> @Html.DisplayFor(modelItem => item.GHICHU)</td>
                                        <td style="white-space: nowrap;" id="ISPHIEUDIEUHANG"> @Html.DisplayFor(modelItem => item.ISPHIEUDIEUHANG)</td>
                                        <td style="white-space: nowrap;" id="CHUNGTUKEMTHEO"> @Html.DisplayFor(modelItem => item.CHUNGTUKEMTHEO)</td>
                                        <td style="white-space: nowrap; " id="NAME_NGUOITAO"> @Html.DisplayFor(modelItem => item.NAME_NGUOITAO)</td>
                                        <td style="white-space: nowrap; " class="fix">
                                            <a class="label label-default" onclick="myFunOpenCamera('@API.ct_PhieuGiaoHang', '', '@item.ID')" href="#"><i class="glyphicon glyphicon-camera" style="margin-right:5px"></i></a>
                                            <a class="label label-default" onclick="myFunctionViewReport('@{@API.ct_PhieuXuat;}','@item.ID')" href="#"><i class="fa fa-print" style="margin-right:5px"></i>@Utility.In</a>
                                            @if (ViewBag.PermissionEdit && !item.ISPHIEUDIEUHANG)
                                            {
                                                if (Utility.IntWidth == 1)
                                                {
                                                    <a class="label label-primary" onclick="myFunctionEdit('@{@API.ct_PhieuXuat;}','@item.ID')" href="#"><i class="fa fa-edit" style="margin-right:5px"></i>@Utility.Sua</a>

                                                }
                                                else
                                                {
                                                    @Html.ActionLink(Utility.Sua, "Edit", new { id = item.ID }, htmlAttributes: new { @class = "label label-primary" });
                                                }
                                            }


                                            @if (ViewBag.PermissionDelete && !item.ISHOANTAT)
                                            {
                                                if (string.IsNullOrEmpty(item.ID_HOADON))
                                                {
                                                    if (Utility.IntWidth == 1)
                                                    {
                                                        <a class="label label-danger" onclick="myFunctionPopup('@{@API.ct_PhieuXuat;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="label label-danger" onclick="myFunction('@{@API.ct_PhieuXuat;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                    }
                                                }
                                            }

                                            @if (!string.IsNullOrEmpty(item.ID_HOADON))
                                            {
                                                if (!string.IsNullOrEmpty(item.DANHSACHPHIEUTRAHANG))
                                                {
                                                    <a class="label label-danger" href="#" onclick="copyToClipboard('@item.MAPHIEU_HOADON.Trim()')"><i class="fa fa-file-text-o" style="margin-right:5px"></i>@item.MAPHIEU_HOADON - (@item.DANHSACHPHIEUTRAHANG)</a>
                                                }
                                                else
                                                {
                                                    <a class="label label-danger" href="#" onclick="copyToClipboard('@item.MAPHIEU_HOADON.Trim()')"><i class="fa fa-file-text-o" style="margin-right:5px"></i>@item.MAPHIEU_HOADON</a>
                                                }
                                            }
                                            else
                                            {

                                                if (ViewBag.PermissionCreateInvoiced)
                                                {
                                                    if (!string.IsNullOrEmpty(item.DANHSACHPHIEUTRAHANG))
                                                    {
                                                        <a class="label label-warning" onclick="myFunctionCreateInvoiced('@{@API.ct_HoaDon;}', document.getElementById('HINHTHUC_THUCHIEN').value,'@item.ID_KHACHHANG','@item.MAPHIEU')" href="#"><i class="fa fa-file-text-o" style="margin-right:5px"></i>@Utility.HoaDon - (@item.DANHSACHPHIEUTRAHANG)</a>
                                                    }
                                                    else
                                                    {
                                                        <a class="label label-success" onclick="myFunctionCreateInvoiced('@{@API.ct_HoaDon;}', document.getElementById('HINHTHUC_THUCHIEN').value,'@item.ID_KHACHHANG','@item.MAPHIEU')" href="#"><i class="fa fa-file-text-o" style="margin-right:5px"></i>@Utility.HoaDon</a>
                                                    }

                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                    </table>
                </div>
            </div><!-- table-responsive -->
        </div>

        <div class="panel-footer">
            @ViewBag.TotalSum
            @if (Model.IPagedList != null)
            {
                @Html.PagedListPager((PagedList.IPagedList<v_ct_PhieuXuat>)Model.IPagedList, page => Url.Action("Index", new { Page = page, ShowSearchValue = ViewBag.showsearchValue, SearchString = ViewBag.searchValue, FromDate = ViewBag.fromdate, ToDate = ViewBag.todate, ID_DEPOT = ViewBag.ID_KHO_DF }))
            }
            @if (ViewBag.PermissionCreateInvoiced)
            {
            <div class="form-group">

                <div class="col-sm-2">
                    <select class="form-control" id="HINHTHUC_THUCHIEN" name="HINHTHUC_THUCHIEN">
                        @foreach (var itm in Model.lstdm_LoaiHoaDon)
                        {
                            string selected = @itm.ISDEFAULT ? "selected" : "";
                            <option value="@itm.ID" @selected>@itm.NAME</option>
                        }
                    </select>
                </div>

                <div class="col-sm-2">
                    <button class="btn btn-primary" onclick="OnSubmitInvoiced()">@Utility.HoaDon</button>
                </div>
            </div>
            }

        </div>
    </div>
</div>

@if (Utility.IntWidth == 1)
{
    if (ViewBag.PermissionCreate)
    {
        <button id="myBtnAdd" style="display:none"></button>
        <div id="myModalAdd" class="modal">
            <div class="panel panel-default" style='width: 90%; margin-left: 5%;'>
                <!-- The Modal -->
                @{Html.RenderAction("Create", @API.ct_PhieuXuat, new { type = 1 });}

                <div id="myProduct">
                </div>
            </div>
        </div>
    }
    if (ViewBag.PermissionEdit)
    {

        <button id="myBtnEdit" style="display:none"></button>
        <div id="myModalEdit" class="modal">
            <div class="panel panel-default" style='width: 90%; margin-left: 5%;'>
                <!-- The Modal -->
                @{Html.RenderAction("Edit", @API.ct_PhieuXuat, new { type = 1, id = "" });}

                <div id="myProductEdit">
                </div>
            </div>
        </div>

    }

    if (ViewBag.PermissionCreateInvoiced)
    {
        <button id="myBtnAdd" style="display:none"></button>
        <div id="myModalAddInvoiced" class="modal">
            <div class="panel panel-default" style='width: 90%; margin-left: 5%;'>
                <!-- The Modal -->
                @{Html.RenderAction("Create", @API.ct_HoaDon, new { type = 1, myModalAdd = "myModalAddInvoiced" });}
            </div>
        </div>
    }
}
@{Html.RenderAction("Image_Input", "FileManager");}
<script>
    function OnchangeCheckboxAuto(event) {
        const isChecked = event.target.checked;
        // Gán trạng thái cho cả hai checkbox
        document.getElementById("myCheckbox").checked = isChecked;
    }
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters       
        $("input[type='hidden'][name='item.CHON']").remove();
    });
    function copyToClipboard(text) {
    navigator.clipboard.writeText(text)
        .then(() => {
            //alert("Đã sao chép: " + text);
        })
        .catch(err => {
            console.error("Lỗi sao chép:", err);
        });
}
</script>