@model MVC_QuanLyTHP.Models.v_v_nv_ChamCong
@using DatabaseTHP;
@using PagedList.Mvc;
@using DatabaseTHP.Class;
@using MVC_QuanLyTHP.Class;
@using MVC_QuanLyTHP.Models;
@using Newtonsoft.Json;
@{
    ViewBag.Title = API.ViewBagTitle;
    Layout = "~/Views/Shared/Admin.cshtml";
}
@Html.Partial("LoadCssDanhMuc")
<hr />
<div class="panel-group" id="accordion">
    <div class="panel panel-default">
        <div class="panel-heading">
            <h1 class="panel-title" style="text-align:center">
                <a data-toggle="collapse" data-parent="#accordion" href="#collapseOneDebt">
                    @Utility.GetTitleFrom(API.nv_ChamCong)
                </a>
            </h1>
        </div>


        <div id="collapseOneDebt" class="panel-collapse collapse in">
            <div class="panel-body panel-body-nopadding">
                <div class="form-horizontal form-bordered">
                    <div class="form-group">
                        <div class="col-sm-3" style="padding-bottom: 5px;">
                            <button id="download-excel" style="background-color: #217346;" class="btn btn-success" onclick="ExportExcel('example-table')"><i class="fa fa-file-text-o" style="margin-right:10px"></i>@Utility.XuatExcel</button>
                            @if (ViewBag.PermissionCreate)
                            {
                                if (Utility.IntWidth == 1)
                                {
                                    <button class="btn btn-success" onclick="myFunctionCreate('@{@API.nv_ChamCong;}')"><i class="fa fa-pencil-square-o" style="margin-right:10px"></i>@Utility.Them</button>
                                }
                                else
                                {
                                    <a class="btn btn-success" href="@Url.Action("Create", API.nv_ChamCong)"><i class="fa fa-pencil-square-o" style="margin-right:20px"></i>@Utility.Them</a>
                                }
                            }
                        </div>
                    </div>
                    @using (Html.BeginForm("Index", API.nv_ChamCong, FormMethod.Post, new AjaxOptions { OnBegin = "OnBegin", OnSuccess = "OnEnd" }))
                    {
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "Thời gian"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-2">
                                @Html.TextBoxFor(model => model.TUNGAY, (Model.TUNGAY).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                                @Html.ValidationMessageFor(model => model.TUNGAY, "", new { @class = "text-danger" })
                            </div>
                            <div class="col-sm-2">
                                @Html.TextBoxFor(model => model.DENNGAY, (Model.DENNGAY).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                                @Html.ValidationMessageFor(model => model.DENNGAY, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "ID_PHONGBAN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-3">
                                <div class="input-group mb15">
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-default" onclick="myFunOpenSearch('collapseOneDebt', '@{@API.dm_PhongBan;}', '@API.Chon1', 'lstdm_PhongBan', '')"><span class="glyphicon glyphicon-search"></span></button>
                                    </span>
                                    @Html.DropDownListFor(model => model.ID_PHONGBAN, new SelectList(Model.lstdm_PhongBan, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_PHONGBAN) ? "" : Utility.GetTitleChon(API.dm_PhongBan), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_PhongBan" })
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "ID_NHANVIEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                            <div class="col-sm-3">
                                <div class="input-group mb15">
                                    <span class="input-group-btn">
                                        <button type="button" class="btn btn-default" onclick="myFunOpenSearch('collapseOneDebt', '@{@API.dm_NhanVien;}', '@API.Chon1', 'lstdm_NhanVien', '')"><span class="glyphicon glyphicon-search"></span></button>
                                    </span>
                                    @Html.DropDownListFor(model => model.ID_NHANVIEN, new SelectList(Model.lstdm_NhanVien, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHANVIEN) ? "" : Utility.GetTitleChon(API.dm_NhanVien), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_NhanVien" })
                                </div>
                            </div>
                        </div>

                        <div class="panel-footer">
                            <div class="row">
                                <div class="col-sm-5 col-sm-offset-2">
                                    <button class="btn btn-primary">@Utility.TimKiem</button>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>



            <div style="overflow-x: auto; Overflow-y: scroll; height: 500px;">
                <div class="panel-body panel-body-nopadding">
                    <div class="form-horizontal form-bordered">
                        <table class="table table-bordered mb30" id="example-table">
                            <thead>
                                <tr>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "THANGNAM")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_KhachHang, "MA")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.dm_KhachHang, "NAME")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "NGAYCONG")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "THOIGIANVAO")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "THOIGIANRA")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "SOTIENGLAMVIEC")</th>
                                    <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "ISNGHIPHEP")</th>
                                    @if (ViewBag.PermissionCreate)
                                    {
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "IP_CHAMCONGVAO")</th>
                                        <th style="font-weight: bold; text-align:center; white-space: nowrap;"> @Utility.GetColumnName(@API.nv_ChamCong, "IP_CHAMCONGRA")</th>
                                    }
                                    <th>

                                    </th>
                                </tr>
                            </thead>

                            @{
                                if (Model.IPagedList != null && Model.IPagedList.Count() > 0)
                                {
                                    <tbody id="tbodytmpitem">

                                        @foreach (var item in Model.IPagedList)
                                        {
                                            string NGAYCONG = item.NGAYCONG.ToString("dd/MM/yyyy");
                                            string THANGNAM = item.NGAYCONG.ToString("MMyyyy");
                                            string THOIGIANVAO = item.THOIGIANVAO != null ? item.THOIGIANVAO.Value.ToString("HH:mm") : "";
                                            string THOIGIANRA = item.THOIGIANRA != null ? item.THOIGIANRA.Value.ToString("HH:mm") : "";
                                            string n = (item.SOTIENGLAMVIEC.ToString().Split(',')).Count() > 1 ? item.SOTIENGLAMVIEC.ToString().Split(',')[1].Length.ToString() : "0";
                                            string SOTIENGLAMVIEC = item.SOTIENGLAMVIEC.ToString("N" + n);
                                            <tr id="@item.ID">
                                                <td style="white-space: nowrap; " id="THANGNAM"> @THANGNAM</td>
                                                <td style="white-space: nowrap; " id="MA"> @Html.DisplayFor(modelItem => item.MA_NHANVIEN)</td>
                                                <td style="white-space: nowrap; " id="NAME"> @Html.DisplayFor(modelItem => item.NAME_NHANVIEN)</td>
                                                <td style="white-space: nowrap; text-align: right;" id="NGAYCONG"> @NGAYCONG</td>
                                                <td style="white-space: nowrap; text-align: right;" id="THOIGIANVAO"> @THOIGIANVAO</td>
                                                <td style="white-space: nowrap; text-align: right;" id="THOIGIANRA"> @THOIGIANRA</td>
                                                <td style="white-space: nowrap; text-align: right;" id="SOTIENGLAMVIEC"> @SOTIENGLAMVIEC</td>
                                                <td style="white-space: nowrap; " id="ISNGHIPHEP"> @Html.DisplayFor(modelItem => item.ISNGHIPHEP)</td>
                                                @if (ViewBag.PermissionCreate)
                                                {
                                                    <td style="white-space: nowrap; " id="IP_CHAMCONGVAO"> @Html.DisplayFor(modelItem => item.IP_CHAMCONGVAO)</td>
                                                    <td style="white-space: nowrap; " id="IP_CHAMCONGRA"> @Html.DisplayFor(modelItem => item.IP_CHAMCONGRA)</td>
                                                }
                                                <td style="white-space: nowrap; " class="fix">
                                                    @if (ViewBag.PermissionEdit)
                                                    {
                                                        if (Utility.IntWidth == 1)
                                                        {
                                                            <a class="label label-primary" onclick="myFunctionEdit('@{@API.nv_ChamCong;}','@item.ID')" href="#"><i class="fa fa-edit" style="margin-right:5px"></i>@Utility.Sua</a>
                                                        }
                                                        else
                                                        {
                                                            @Html.ActionLink(Utility.Sua, "Edit", new { id = item.ID }, htmlAttributes: new { @class = "label label-primary" });
                                                        }
                                                    }
                                                    @if (ViewBag.PermissionDelete)
                                                    {
                                                        if (Utility.IntWidth == 1)
                                                        {
                                                            <a class="label label-danger" onclick="myFunctionPopup('@{@API.nv_ChamCong;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                        }
                                                        else
                                                        {
                                                            <a class="label label-danger" onclick="myFunction('@{@API.nv_ChamCong;}','@item.ID')" href="#"><i class="glyphicon glyphicon-trash" style="margin-right:5px"></i>@Utility.Xoa</a>
                                                        }

                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                }
                            }
                        </table>
                    </div>
                </div><!-- table-responsive -->
            </div>


        </div>
        <div class="panel-footer">
        </div>
    </div>
</div>
