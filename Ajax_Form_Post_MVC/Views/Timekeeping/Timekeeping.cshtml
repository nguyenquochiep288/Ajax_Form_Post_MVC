<script>
    const now = new Date('@(((DateTime) ViewData["TIMER"]).ToString("o"))');
    function updateTime() {
        const currentTimeElement = document.getElementById('currentTime');
        now.setSeconds(now.getSeconds() + 1);
        const hours = String(now.getHours()).padStart(2, '0');
        const minutes = String(now.getMinutes()).padStart(2, '0');
        const seconds = String(now.getSeconds()).padStart(2, '0');
        currentTimeElement.textContent = `Giờ làm việc hôm nay: ${hours}:${minutes}:${seconds}`;
    }

    setInterval(updateTime, 1000);
    updateTime();


    function getIpaddress()
    {
        fetch('https://api.ipify.org/?format=json').then(res => {
            return res.json()
        }).then(data => {
            document.getElementById("MYPUBLICIPV4").value = data.ip;
            /*ipElem.innerHTML += ('<br>My Public IPv4:' + data.ip);*/
        }).catch(err => {
            console.log(`There was an error ${err}`)
        })
    }
    getIpaddress();

    function Timekeeping()
    {
        if (navigator.geolocation)
        {
            navigator.geolocation.getCurrentPosition(showPosition);
        } else {
            document.getElementById("myModalAdd").innerHTML =
                "Geolocation is not supported by this browser.";
        }
    }
    function showPosition(position)
    {
        const userAgent = navigator.userAgent;
        let deviceName = 'Unknown Device';

        // Phân tích userAgent
        if (/iPad|iPhone|iPod/.test(userAgent)) {
            deviceName = 'Apple iOS Device';
        } else if (/Android/.test(userAgent)) {
            deviceName = 'Android Device';
        } else if (/Windows/.test(userAgent)) {
            deviceName = 'Windows Device';
        } else if (/Macintosh/.test(userAgent)) {
            deviceName = 'Mac Device';
        } else if (/Linux/.test(userAgent)) {
            deviceName = 'Linux Device';
        }
        if (deviceName == 'Apple iOS Device' || deviceName == 'Android Device')
        {

        }
        else
        {
            alert("Vui lòng truy cập trên điện thoại!" + deviceName);
            return;
        }

        document.getElementById("myModalAdd").innerHTML = position.coords.latitude + "-" + position.coords.longitude;
        document.getElementById("LATITUDELONGITUDE").value = position.coords.latitude + "-" + position.coords.longitude;
        @Html.Raw(@ViewData["TYPEFORM"].ToString())
    }
</script>
