@model MVC_QuanLyTHP.Models.v_v_nv_ChamCong
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("CreatePopup", API.nv_ChamCong, new AjaxOptions { OnSuccess = "OnSuccessCreate" }))
    {
        //@Html.AntiForgeryToken()

        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalAdd")'>&times;</a>
            </div>
            <input type="hidden" name="idProduct" id="idProduct" />
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.nv_ChamCong)</label></h1>
            <div class="panel-body" style="padding:5px">
            </div>
        </div>
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.LOC_ID)
        @Html.HiddenFor(model => model.ID)

        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "ID_NHANVIEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_NHANVIEN, new SelectList(Model.lstdm_NhanVien, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHANVIEN) ? "" : Utility.GetTitleChon(API.dm_NhanVien), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_NhanVien" })
                        @Html.ValidationMessageFor(model => model.ID_NHANVIEN, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "ID_THANGLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.ID_THANGLUONG, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ID_THANGLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>*@
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "NGAYCONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.NGAYCONG, (Model.NGAYCONG).ToString("yyyy-MM-dd"), new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                        @Html.ValidationMessageFor(model => model.NGAYCONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "THOIGIANVAO"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.THOIGIANVAO, Model.THOIGIANVAO != null ? (Model.THOIGIANVAO).Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "datetime-local" })
                        @Html.ValidationMessageFor(model => model.THOIGIANVAO, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "THOIGIANRA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.THOIGIANRA, Model.THOIGIANRA != null ? (Model.THOIGIANRA).Value.ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "datetime-local" })
                        @Html.ValidationMessageFor(model => model.THOIGIANRA, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "SOTIENGLAMVIEC"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SOTIENGLAMVIEC, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.SOTIENGLAMVIEC, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.GHICHU, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GHICHU, "", new { @class = "text-danger" })
                    </div>
                </div>
                @*<div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_ChamCong, "ISNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.ISNGHIPHEP, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ISNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>*@

            </div>
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalAdd")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
   
}
