@using MVC_QuanLyTHP.Class;
@using DatabaseTHP;
<script type="text/javascript">
    $(function () {
        $('#BUTTONTYPE').click(function () {
            if (confirm("Vui lòng kiểm tra đơn hàng đã lấy khuyến mãi hay chưa! Bấm 'OK' để tiếp tục tạo đơn hàng?"))
                return true;
            else {
                event.preventDefault();
                return false;
            }
        });
    });

    function getLocationDeposit() {
        try {
            if (navigator.geolocation) {

                navigator.geolocation.getCurrentPosition(showPositionDeposit, showErrorDeposit);
            } else {
                var x = document.getElementsByName("demoMap");
                if (x != null && x.length > 0) {
                    for (var i = 0; i < x.length; i++) {
                        x[i].innerHTML = "Geolocation không được hỗ trợ bởi trình duyệt này.";
                    }
                }
            }
        }
        catch
        {
        }
    }
    function showPositionDeposit(position) {
        var x = document.getElementsByName("demoMap");
        if (x != null && x.length > 0) {
            for (var i = 0; i < x.length; i++) {
                x[i].innerHTML = "Vĩ độ: " + position.coords.latitude +
                    "<br>Kinh độ: " + position.coords.longitude;
            }
        }
        //xdemoMap.innerHTML =

        var LATITUDE = document.getElementsByName("LATITUDE");
        if (LATITUDE != null && LATITUDE.length > 0) {
            for (var i = 0; i < LATITUDE.length; i++) {
                LATITUDE[i].value = position.coords.latitude;
            }
        }
        var LONGITUDE = document.getElementsByName("LONGITUDE");
        if (LONGITUDE != null && LONGITUDE.length > 0) {
            for (var i = 0; i < LONGITUDE.length; i++) {
                LONGITUDE[i].value = position.coords.longitude;
            }
        }

    }
    function showErrorDeposit(error) {
        var strerror = "";
        switch (error.code) {
            case error.PERMISSION_DENIED:
                strerror = "Người sử dụng từ chối cho xác định vị trí."
                break;
            case error.POSITION_UNAVAILABLE:
                strerror = "Thông tin vị trí không có sẵn."
                break;
            case error.TIMEOUT:
                strerror = "Yêu cầu vị trí người dùng vượt quá thời gian quy định."
                break;
            case error.UNKNOWN_ERROR:
                strerror = "Một lỗi xảy ra không rõ nguyên nhân."
                break;
        }
        var x = document.getElementsByName("demoMap");
        if (x != null && x.length > 0) {
            for (var i = 0; i < x.length; i++) {
                x[i].innerHTML = strerror;
            }
        }
    }

</script>
