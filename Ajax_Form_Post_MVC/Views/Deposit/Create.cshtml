                                <button class="btn btn-primary" asp-page-handler="Submit" onclick="validatetext()" value="Save" name="BUTTONTYPE">@Utility.ThucHien</button>
                                @if (Request.UrlReferrer != null)
                                {
                                    <a href="@Request.UrlReferrer.ToString()" class="btn btn-danger">@Utility.QuayLai</a>
                                }
                                else
                                {

                                    @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                                }
                                @*@if (Model.listvwPhieuGoiHang.Count > 0)
                                    { @Html.ActionLink("Download File", "Download")}*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>



        </div>
    }
    
    <div id="myProduct">
        @Html.Raw(ViewBag.NhomHang)
    </div>
}

