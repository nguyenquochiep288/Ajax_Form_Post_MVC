@model MVC_QuanLyTHP.Models.v_v_nv_NghiPhep
@using MVC_QuanLyTHP.Class;
@using DatabaseTHP.Class;
@if (Utility.IntWidth == 1)
{
    using (Ajax.BeginForm("EditPopup", API.nv_NghiPhep, new AjaxOptions { OnSuccess = "OnSuccessEdit" }))
    {
        @Html.AntiForgeryToken()
        <div class="panel-heading" style="padding-bottom:5px">
            <div class="panel-btns">
                <a onclick='myFunClosed("myModalEdit")'>&times;</a>
            </div>
            <input type="hidden" name="idProduct" id="idProduct" />
            <h1 class="panel-title" style="font-size: 20px;text-align: center "><label id="lblName" name="lblName">@Utility.GetTitleFrom(API.nv_NghiPhep)</label></h1>
            <div class="panel-body" style="padding:5px">

            </div>
        </div>

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div id="ValidationSummary" class="validation-summary-errors text-danger">
        </div>
        @Html.HiddenFor(model => model.LOC_ID)
        @Html.HiddenFor(model => model.ID)

        <div class="panel-body panel-body-nopadding">
            <div class="form-horizontal form-bordered">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "ID_NHANVIEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_NHANVIEN, new SelectList(Model.lstdm_NhanVien, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHANVIEN) ? "" : Utility.GetTitleChon(API.dm_NhanVien), htmlAttributes: new { @class = "form-control chosen-select", id = "lstdm_NhanVienEdit" })
                        @Html.ValidationMessageFor(model => model.ID_NHANVIEN, "", new { @class = "text-danger" })
                    </div>
                </div>
               
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "ID_PHEPNAM"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_PHEPNAM, new SelectList(Model.lstnv_PhepNam, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_PHEPNAM) ? "" : Utility.GetTitleChon(API.nv_PhepNam), htmlAttributes: new { @class = "form-control", id = "lstnv_PhepNam" })
                        @Html.ValidationMessageFor(model => model.ID_PHEPNAM, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "HINHTHUCNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.DropDownListFor(model => model.HINHTHUCNGHIPHEP, new SelectList(Model.lstTYPENghiPhep, "ID", "NAME"), "", htmlAttributes: new { @class = "form-control chosen-select", id = "lstTYPENghiPhepEdit" })
                        @Html.ValidationMessageFor(model => model.HINHTHUCNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "THOIGIANVAO"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.THOIGIANVAO, Model.THOIGIANVAO != null ? (Model.THOIGIANVAO).ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                        @Html.ValidationMessageFor(model => model.THOIGIANVAO, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div id="divTHOIGIANRA" class="form-group">
                    <div class="form-group">
                        @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "THOIGIANRA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                        <div class="col-sm-5">
                            @Html.TextBoxFor(model => model.THOIGIANRA, Model.THOIGIANRA != null ? (Model.THOIGIANRA).ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                            @Html.ValidationMessageFor(model => model.THOIGIANRA, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.GHICHU, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GHICHU, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "ISNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.ISNGHIPHEP, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ISNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>
        </div>
        <div class="panel-footer">
            <div class="row">
                <div class="col-sm-5 col-sm-offset-3">
                    <button class="btn btn-primary">@Utility.ThucHien</button>
                    <a class="btn btn-danger" onclick='myFunClosed("myModalEdit")'>@Utility.Dong</a>
                </div>
            </div>
        </div>

    }
}
else
{
    {
        ViewBag.Title = API.ViewBagTitle;
        Layout = "~/Views/Shared/Admin.cshtml";
    }
    <hr />
    using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="panel-group" id="accordion">
            <div class="panel panel-default">
                <div class="panel-heading">
                    <h1 class="panel-title" style="text-align:center">
                        <a data-toggle="collapse" data-parent="#accordion" href="#collapseOne">
                            @Utility.GetTitleFrom(API.nv_NghiPhep)
                        </a>
                    </h1>
                </div>
                <hr />
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(model => model.LOC_ID)
                @Html.HiddenFor(model => model.ID)

            <div id="collapseOne" class="panel-collapse collapse in">
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "ID_NHANVIEN"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-md-5">
                        @Html.DropDownListFor(model => model.ID_NHANVIEN, new SelectList(Model.lstdm_NhanVien, "ID", "NAME"), !string.IsNullOrEmpty(Model.ID_NHANVIEN) ? "" : Utility.GetTitleChon(API.dm_NhanVien), htmlAttributes: new { @class = "form-control", id = "lstdm_NhanVienEdit" })
                        @Html.ValidationMessageFor(model => model.ID_NHANVIEN, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "THOIGIANVAO"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.THOIGIANVAO, Model.THOIGIANVAO != null ? (Model.THOIGIANVAO).ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                        @Html.ValidationMessageFor(model => model.THOIGIANVAO, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "THOIGIANRA"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.TextBoxFor(model => model.THOIGIANRA, Model.THOIGIANRA != null ? (Model.THOIGIANRA).ToString("yyyy-MM-dd") : "", new { @class = "form-control hasDatepicker", @placeholder = "dd/MM/yyyy", @type = "date" })
                        @Html.ValidationMessageFor(model => model.THOIGIANRA, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "GHICHU"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.GHICHU, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.GHICHU, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "ISNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.CheckBoxFor(model => model.ISNGHIPHEP, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.ISNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "SOLUONG"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.SOLUONG, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.SOLUONG, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.Label(@Utility.GetColumnName(@API.nv_NghiPhep, "HINHTHUCNGHIPHEP"), htmlAttributes: new { @class = "col-sm-2 control-label" })
                    <div class="col-sm-5">
                        @Html.EditorFor(model => model.HINHTHUCNGHIPHEP, new { htmlAttributes = new { @class = "form-control", @type = "number" } })
                        @Html.ValidationMessageFor(model => model.HINHTHUCNGHIPHEP, "", new { @class = "text-danger" })
                    </div>
                </div>

            </div>

                <div class="panel-footer">
                    <div class="row">
                        <div class="col-sm-5 col-sm-offset-2">
                            <button class="btn btn-primary">@Utility.ThucHien</button>
                            @if (Request.UrlReferrer != null)
                            {
                                <a href="@Request.UrlReferrer.ToString()" class="btn btn-danger">@Utility.QuayLai</a>
                            }
                            else
                            {

                                @Html.ActionLink(Utility.QuayLai, "Index", null, new { @class = "btn btn-danger" })
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}
<script type="text/javascript">
    $(function () {
        // delete extra hidden fields created by checkboxes as the grid links mess this up by doubling the querystring parameters
        $("input[type='hidden'][name='ISACTIVE']").remove();
        $("input[type='hidden'][name='ISNGHIPHEP']").remove();
    });
</script>